# ~/.zshenv で ZDOTDIR を変えても、zsh は変更先の .zshenv を読み直さない。
# 環境定義を明示的に読み、以後の .zprofile / .zshrc も同じ場所から読む。
# /etc/zshenv で ZDOTDIR を上書きすると Orca などの起動ラッパーを壊すので、
# ユーザー設定はここで管理する。
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
if [[ -r "$ZDOTDIR/.zshenv" ]]; then
  source "$ZDOTDIR/.zshenv"
fi
