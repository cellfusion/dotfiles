{
  "version": 2,
  "defaults": { "environment": "primary" },
  "providers": {
    "claude": {
      "displayName": "Claude",
      "setup": {
        "configDirectoryEnv": { "CLAUDE_CONFIG_DIR": "claude" },
        "directoryPattern": { "primary": "$XDG_CONFIG_HOME/claude", "nonPrimary": "$XDG_CONFIG_HOME/claude_<environment>" }
      }
    },
    "codex": {
      "displayName": "Codex",
      "setup": {
        "configDirectoryEnv": { "CODEX_HOME": "codex" },
        "directoryPattern": { "primary": "$XDG_CONFIG_HOME/codex", "nonPrimary": "$XDG_CONFIG_HOME/codex_<environment>" }
      }
    },
    "opencode": { "displayName": "opencode", "setup": null }
  },
  "environments": {
    "primary": { "providers": ["claude", "codex", "opencode"] },
    "lab": { "providers": ["claude", "codex"] }
  }
}
