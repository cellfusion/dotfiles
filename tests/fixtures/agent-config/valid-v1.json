{
  "version": 1,
  "defaults": { "environment": "primary", "tier": "work" },
  "providers": {
    "claude": { "displayName": "Claude", "setup": { "configDirectoryEnv": { "CLAUDE_CONFIG_DIR": "claude" }, "directoryPattern": { "primary": "$XDG_CONFIG_HOME/claude", "nonPrimary": "$XDG_CONFIG_HOME/claude_<environment>" }, "symlinks": ["agents", "commands", "skills", "hooks", "CLAUDE.md", "settings.json"], "preservedMutable": [".claude.json"], "existingPathPolicy": "reject-real-or-wrong-symlink" }, "featureAllowlist": { "fast_mode": "boolean" } },
    "codex": { "displayName": "Codex", "setup": { "configDirectoryEnv": { "CODEX_HOME": "codex" }, "directoryPattern": { "primary": "$XDG_CONFIG_HOME/codex", "nonPrimary": "$XDG_CONFIG_HOME/codex_<environment>" }, "symlinks": ["agents", "AGENTS.md"], "preservedMutable": ["config.toml"], "existingPathPolicy": "reject-real-or-wrong-symlink" }, "featureAllowlist": { "fast_mode": "boolean" } },
    "opencode": { "displayName": "OpenCode", "setup": null, "featureAllowlist": {} },
    "pi": { "displayName": "Pi", "setup": null, "featureAllowlist": {} }
  },
  "tiers": {
    "light": { "candidates": [{ "provider": "codex", "model": "sample-light", "thinkingOptionId": "medium", "featureValues": {} }] },
    "work": { "candidates": [{ "provider": "codex", "model": "sample-work", "thinkingOptionId": "high", "featureValues": { "fast_mode": true } }] },
    "think": { "candidates": [{ "provider": "claude", "model": "sample-think", "thinkingOptionId": "high", "featureValues": { "fast_mode": false } }] },
    "deep": { "candidates": [{ "provider": "claude", "model": "sample-deep", "thinkingOptionId": "max", "featureValues": { "fast_mode": true } }] }
  },
  "environments": {
    "primary": { "providers": ["claude", "codex", "opencode", "pi"], "tiers": {} },
    "lab": { "providers": ["claude", "codex"], "tiers": { "work": { "candidates": [{ "provider": "codex", "model": "sample-lab-work", "thinkingOptionId": "high", "featureValues": { "fast_mode": false } }] } } }
  },
  "agentRoles": {
    "implementer": { "tier": "work", "access": "write", "description": "実装と検証を行う", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["implementer"] },
    "task-reviewer": { "tier": "work", "access": "read", "description": "タスクの差分をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "re-reviewer": { "tier": "light", "access": "read", "description": "指摘の解消を判定する", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "final-reviewer": { "tier": "deep", "access": "read", "description": "ブランチ全体をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "reviewer": { "access": "read", "description": "成果物をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] }
  },
  "projectRouting": { "rules": [{ "name": "sample-project", "environment": "lab", "match": { "remote": "example.test/Org/Repo" } }] }
}
