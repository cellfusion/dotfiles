{
  "version": 2,
  "defaults": { "environment": "primary", "complexity": "work" },
  "providers": {
    "claude": { "displayName": "Claude", "setup": { "configDirectoryEnv": { "CLAUDE_CONFIG_DIR": "claude" }, "directoryPattern": { "primary": "$XDG_CONFIG_HOME/claude", "nonPrimary": "$XDG_CONFIG_HOME/claude_<environment>" }, "symlinks": ["agents", "commands", "skills", "hooks", "CLAUDE.md", "settings.json"], "preservedMutable": [".claude.json"], "existingPathPolicy": "reject-real-or-wrong-symlink" }, "featureAllowlist": {} },
    "codex": { "displayName": "Codex", "setup": { "configDirectoryEnv": { "CODEX_HOME": "codex" }, "directoryPattern": { "primary": "$XDG_CONFIG_HOME/codex", "nonPrimary": "$XDG_CONFIG_HOME/codex_<environment>" }, "symlinks": ["agents", "AGENTS.md", "rules"], "preservedMutable": ["config.toml"], "existingPathPolicy": "reject-real-or-wrong-symlink" }, "featureAllowlist": {} },
    "opencode": { "displayName": "OpenCode", "setup": null, "featureAllowlist": {} },
    "pi": { "displayName": "Pi", "setup": null, "featureAllowlist": {} }
  },
  "selection": {
    "light": { "candidates": [{ "provider": "codex", "model": "sample-light", "effort": "medium", "features": {} }] },
    "work": { "candidates": [{ "provider": "codex", "model": "sample-work", "effort": "high", "features": {} }] },
    "think": { "candidates": [{ "provider": "claude", "model": "sample-think", "effort": "high", "features": {} }] },
    "deep": { "candidates": [{ "provider": "claude", "model": "sample-deep", "effort": "max", "features": {} }] }
  },
  "environments": {
    "primary": { "providers": ["claude", "codex", "opencode", "pi"], "selection": {} },
    "lab": { "providers": ["claude", "codex"], "selection": { "work": { "candidates": [{ "provider": "codex", "model": "sample-lab-work", "effort": "high", "features": {} }] } } }
  },
  "agentRoles": {
    "implementer": { "complexity": "work", "access": "write", "description": "実装と検証を行う", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["implementer"] },
    "task-reviewer": { "complexity": "work", "access": "read", "description": "タスクの差分をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "re-reviewer": { "complexity": "light", "access": "read", "description": "指摘の解消を判定する", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "final-reviewer": { "complexity": "deep", "access": "read", "description": "ブランチ全体をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "reviewer": { "access": "read", "description": "成果物をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] }
  },
  "projectRouting": { "rules": [{ "name": "sample-project", "environment": "lab", "match": { "remote": "example.test/Org/Repo" } }] }
