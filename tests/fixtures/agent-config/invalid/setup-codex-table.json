{
  "version": 2,
  "defaults": {
    "environment": "primary",
    "complexity": "standard"
  },
  "providers": {
    "codex": {
      "displayName": "Codex",
      "setup": {
        "configDirectoryEnv": {
          "CODEX_HOME": "codex"
        },
        "directoryPattern": {
          "primary": "$XDG_CONFIG_HOME/codex",
          "nonPrimary": "$XDG_CONFIG_HOME/codex_<environment>"
        },
        "symlinks": [
          "agents",
          "AGENTS.md",
          "rules"
        ],
        "preservedMutable": [],
        "existingPathPolicy": "reject-real-or-wrong-symlink"
      },
      "featureAllowlist": {},
      "backends": [
        "paseo"
      ]
    }
  },
  "environments": {
    "primary": {
      "providers": [
        "codex"
      ],
      "selection": {}
    }
  },
  "agentRoles": {
    "reviewer": {
      "access": "read",
      "description": "anonymous reviewer",
      "artifactContract": "mad-attempt-v1",
      "deliveryDuties": [
        "reviewer"
      ]
    }
  },
  "projectRouting": {
    "rules": []
  },
  "selection": {
    "author": {
      "routine": {
        "candidates": [
          {
            "provider": "codex",
            "model": "anonymous-light",
            "effort": "low",
            "features": {}
          }
        ]
      },
      "standard": {
        "candidates": [
          {
            "provider": "codex",
            "model": "anonymous-work",
            "effort": "high",
            "features": {}
          }
        ]
