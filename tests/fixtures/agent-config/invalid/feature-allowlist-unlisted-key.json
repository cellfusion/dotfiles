{
  "version": 2,
  "defaults": {
    "environment": "primary",
    "complexity": "routine"
  },
  "providers": {
    "claude": {
      "displayName": "Claude",
      "setup": {
        "configDirectoryEnv": {
          "CLAUDE_CONFIG_DIR": "claude"
        },
        "directoryPattern": {
          "primary": "$XDG_CONFIG_HOME/claude",
          "nonPrimary": "$XDG_CONFIG_HOME/claude_<environment>"
        },
        "symlinks": [
          "agents",
          "commands",
          "skills",
          "hooks",
          "CLAUDE.md",
          "settings.json"
        ],
        "preservedMutable": [
          ".claude.json"
        ],
        "existingPathPolicy": "reject-real-or-wrong-symlink"
      },
      "featureAllowlist": {
        "fast_mode": "boolean",
        "verbose": "boolean"
      },
      "backends": [
        "paseo"
      ]
    },
    "codex": {
      "displayName": "Codex",
      "setup": {
        "configDirectoryEnv": {
          "CODEX_HOME": "codex"
        },
        "directoryPattern": {
          "primary": "$XDG_CONFIG_HOME/codex",
          "nonPrimary": "$XDG_CONFIG_HOME/codex_<environment>"
        },
        "symlinks": [
          "agents",
          "AGENTS.md",
          "rules"
        ],
        "preservedMutable": [
          "config.toml"
        ],
        "existingPathPolicy": "reject-real-or-wrong-symlink"
      },
      "featureAllowlist": {
        "fast_mode": "boolean"
      },
      "backends": [
        "paseo"
      ]
    },
    "opencode": {
      "displayName": "OpenCode",
      "setup": null,
      "featureAllowlist": {},
      "backends": [
        "paseo"
      ]
    },
    "pi": {
      "displayName": "Pi",
      "setup": null,
      "featureAllowlist": {},
      "backends": [
        "paseo"
      ]
    }
  },
  "environments": {
    "primary": {
      "providers": [
        "claude",
        "codex",
        "opencode",
        "pi"
      ],
      "selection": {}
    },
    "lab": {
      "providers": [
        "claude",
        "codex"
      ],
      "selection": {
        "review": {
          "routine": {
            "candidates": [
              {
                "provider": "codex",
                "model": "sample-lab-work",
                "effort": "high",
                "features": {
                  "fast_mode": false
                }
              }
            ]
          }
        }
      }
    }
  },
  "agentRoles": {
    "implementer": {
      "access": "write",
      "description": "実装と検証を行う",
      "artifactContract": "mad-attempt-v1",
      "deliveryDuties": [
        "implementer"
      ],
      "duty": "implement"
    },
    "task-reviewer": {
      "access": "read",
      "description": "タスクの差分をレビューする",
      "artifactContract": "mad-attempt-v1",
      "deliveryDuties": [
        "reviewer"
      ],
      "duty": "review"
    },
    "re-reviewer": {
      "access": "read",
      "description": "指摘の解消を判定する",
      "artifactContract": "mad-attempt-v1",
      "deliveryDuties": [
        "reviewer"
      ],
      "duty": "review"
    },
    "final-reviewer": {
      "access": "read",
      "description": "ブランチ全体をレビューする",
      "artifactContract": "mad-attempt-v1",
      "deliveryDuties": [
        "reviewer"
      ],
      "duty": "review"
    },
    "reviewer": {
      "access": "read",
      "description": "成果物をレビューする",
      "artifactContract": "mad-attempt-v1",
      "deliveryDuties": [
        "reviewer"
      ]
    }
  },
  "projectRouting": {
    "rules": [
      {
        "name": "sample-project",
        "environment": "lab",
        "match": {
          "remote": "example.test/Org/Repo"
        }
      }
    ]
  },
