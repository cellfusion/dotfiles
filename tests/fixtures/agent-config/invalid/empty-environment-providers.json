{
  "version": 2,
  "defaults": {
    "environment": "primary",
    "complexity": "standard"
  },
  "providers": {
    "claude": {
      "displayName": "Claude",
      "setup": {
        "configDirectoryEnv": {
          "CLAUDE_CONFIG_DIR": "claude"
        },
        "directoryPattern": {
          "primary": "$XDG_CONFIG_HOME/claude",
          "nonPrimary": "$XDG_CONFIG_HOME/claude_<environment>"
        },
        "symlinks": [
          "agents",
          "commands",
          "skills",
          "hooks",
          "CLAUDE.md",
          "settings.json"
        ],
        "preservedMutable": [
          ".claude.json"
        ],
        "existingPathPolicy": "reject-real-or-wrong-symlink"
      },
      "featureAllowlist": {},
      "backends": [
        "paseo"
      ]
    }
  },
  "environments": {
    "primary": {
      "providers": [],
      "selection": {}
    }
  },
  "agentRoles": {
    "reviewer": {
      "access": "read",
      "description": "review",
      "artifactContract": "mad-attempt-v1",
      "deliveryDuties": [
        "reviewer"
      ]
    }
  },
  "projectRouting": {
    "rules": []
  },
  "selection": {
    "author": {
      "routine": {
        "candidates": [
          {
            "provider": "claude",
            "model": "anonymous-light",
            "effort": "low",
            "features": {}
          }
        ]
      },
      "standard": {
        "candidates": [
          {
            "provider": "claude",
            "model": "anonymous-work",
            "effort": "high",
            "features": {}
