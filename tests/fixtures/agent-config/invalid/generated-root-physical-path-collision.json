{
  "version": 2,
  "defaults": {
    "environment": "primary",
    "complexity": "routine"
  },
  "providers": {
    "claude": {
      "displayName": "Claude",
      "setup": {
        "configDirectoryEnv": {
          "CLAUDE_CONFIG_DIR": "shared"
        },
        "directoryPattern": {
          "primary": "$XDG_CONFIG_HOME/shared",
          "nonPrimary": "$XDG_CONFIG_HOME/shared_<environment>"
        },
        "symlinks": [],
        "preservedMutable": [],
        "existingPathPolicy": "reject-real-or-wrong-symlink"
      },
      "featureAllowlist": {},
      "backends": [
        "paseo"
      ]
    },
    "codex": {
