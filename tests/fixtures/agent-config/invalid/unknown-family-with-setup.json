    "pi": {
      "displayName": "Pi",
      "setup": {
        "configDirectoryEnv": {
          "PI_HOME": "pi"
        },
        "directoryPattern": {
          "primary": "$XDG_CONFIG_HOME/pi",
          "nonPrimary": "$XDG_CONFIG_HOME/pi_<environment>"
        },
        "symlinks": [],
        "preservedMutable": [],
        "existingPathPolicy": "reject-real-or-wrong-symlink"
      },
      "featureAllowlist": {},
      "backends": [
