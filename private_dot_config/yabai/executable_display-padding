#!/usr/bin/env sh
# CoreGraphics で内蔵ディスプレイの位置を取得し、yabai の frame と照合する。
builtin_frame=$(swift -e '
import CoreGraphics
var displays = [CGDirectDisplayID](repeating: 0, count: 32)
var count: UInt32 = 0
guard CGGetOnlineDisplayList(32, &displays, &count) == .success else { exit(1) }
for display in displays.prefix(Int(count)) where CGDisplayIsBuiltin(display) != 0 {
    let frame = CGDisplayBounds(display)
    print("\(Int(frame.origin.x))\t\(Int(frame.origin.y))\t\(Int(frame.width))\t\(Int(frame.height))")
}
' 2>/dev/null) || exit 1
[ -n "$builtin_frame" ] || exit 1

# グローバル既定値は内蔵向け。各スペースの余白を再設定する。
yabai -m config top_padding 0
yabai -m query --displays | jq -r \
  '.[] | .frame as $frame | .spaces[] | [$frame.x, $frame.y, $frame.w, $frame.h, .] | @tsv' |
while IFS="$(printf '\t')" read -r x y w h space; do
  if [ "$(printf '%s\t%s\t%s\t%s' "$x" "$y" "$w" "$h")" = "$builtin_frame" ]; then
    padding=0
  else
    padding=38
  fi
  yabai -m config --space "$space" top_padding "$padding"
done
