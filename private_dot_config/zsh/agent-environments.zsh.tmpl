{{- /* Claude/Codex environments come from private-data.toml.
       The first environment uses the unsuffixed configuration directories. */ -}}
{{- $envs := list (dict "session" "default" "label" "P1" "agents" (list "claude" "codex")) -}}
{{- if hasKey . "environments" }}{{ $envs = .environments }}{{ end }}
# chezmoi が生成する。直接編集しない。
# 元: private_dot_config/zsh/agent-environments.zsh.tmpl
# 定義: ~/.config/chezmoi/private-data.toml の [[data.environments]]
#
# Claude/Codex use the cwd-aware environment resolver; OMP uses its native default.

_agent_env_apply() {
  case "$1" in
{{- range $i, $env := $envs }}
{{- $suffix := ternary (printf "_%s" $env.session) "" (ne $i 0) }}
{{- $wrangler := ternary (printf ".wrangler-%s" $env.session) ".wrangler" (ne $i 0) }}
{{- $cf := dig "cloudflareAccountId" "" $env }}
{{- $agents := list }}
{{- range $family := list "claude" "codex" }}
{{- if has $family $env.agents }}{{ $agents = append $agents $family }}{{ end }}
{{- end }}
    {{ $env.session }})
{{- if has "claude" $env.agents }}
      export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude{{ $suffix }}"
{{- else }}
      unset CLAUDE_CONFIG_DIR
{{- end }}
{{- if has "codex" $env.agents }}
      export CODEX_HOME="$XDG_CONFIG_HOME/codex{{ $suffix }}"
{{- else }}
      unset CODEX_HOME
{{- end }}
      export WRANGLER_HOME="$XDG_CONFIG_HOME/{{ $wrangler }}"
{{- if $cf }}
      export CLOUDFLARE_ACCOUNT_ID="{{ $cf }}"
{{- else }}
      unset CLOUDFLARE_ACCOUNT_ID
{{- end }}
      export AGENT_ENV_SESSION="{{ $env.session }}"
      export AGENT_ENV_AGENTS="{{ join " " $agents }}"
      ;;
{{- end }}
    *) return 1 ;;
  esac
}

# 環境名は AGENT_ENV が正で、HERDR_SESSION は herdr が注入する別名である。
# 定義の無い名前と、どちらも未設定の場合は、どの環境も読み込まない。先頭環境へ
# 落とすと、指定し忘れがそのまま別の環境での作業になる。
_agent_env_clear() {
  unset CLAUDE_CONFIG_DIR CODEX_HOME WRANGLER_HOME CLOUDFLARE_ACCOUNT_ID AGENT_ENV_SESSION
  export AGENT_ENV_AGENTS=""
}
_agent_env_apply "${AGENT_ENV:-${HERDR_SESSION:-}}" || _agent_env_clear

# 通常起動を agent-config の family resolver に通す。agent は子 process なので、
# この function を再帰せず PATH 上の実 CLI を exec する。
claude() {
  command agent --family=claude -- "$@"
}

codex() {
  if [ "${1-}" = update ]; then
    command codex "$@"
    return $?
  fi
  command agent --family=codex -- "$@"
}


omp() {
  (unset OMP_PROFILE PI_CODING_AGENT_DIR; PI_FORCE_IMAGE_PROTOCOL="${PI_FORCE_IMAGE_PROTOCOL:-kitty}" command omp "$@")
}
