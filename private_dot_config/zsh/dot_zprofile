# 新マシンの初回起動時点では Homebrew がまだ入っていないことがある。
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"


# Added by Toolbox App
export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
export LC_ALL=en_US.UTF-8

# Setting PATH for Python 3.12
# The original version is saved in .zprofile.pysave
PATH="/Library/Frameworks/Python.framework/Versions/3.12/bin:${PATH}"
export PATH

# ANDROID_HOME は .zshenv で定義する（非 login shell でも要るため）

export JAVA_HOME="$HOME/Applications/Android Studio.app/Contents/jbr/Contents/Home"

export PATH="$PATH:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/33.0.1:$ANDROID_HOME/tools/bin"

export NDKROOT="$ANDROID_HOME/ndk/25.1.8937393"
export NDK_ROOT="$ANDROID_HOME/ndk/25.1.8937393"
