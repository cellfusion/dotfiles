
# Zsh
# compinit -d "$XDG_CACHE_HOME"/zsh/zcompdump-"$ZSH_VERSION"
export HISTFILE="$XDG_STATE_HOME"/zsh/history

# fzf (binary still used by claude-monitor)
export FZF_DEFAULT_OPTS="--color=fg:#c0caf5,bg:-1,hl:#ff9e64,fg+:#c0caf5,bg+:#283457,hl+:#ff9e64,info:#7aa2f7,prompt:#7dcfff,pointer:#bb9af7,marker:#9ece6a,spinner:#bb9af7,header:#565f89"

# television (replaces fzf shell integration: Ctrl-T, Ctrl-R)
eval "$(tv init zsh | grep -v 'compdef')"

# tv's smart_autocomplete only completes an existing token. On an empty prompt it
# falls back to `zle ${fzf_default_completion:-expand-or-complete}`, which dumps
# every command ("do you wish to see all 4275 possibilities?"). Send it nowhere
# instead. The fallback also returns early without re-enabling bracketed paste,
# so do that here.
_tv_noop() { _enable_bracketed_paste }
zle -N tv-noop _tv_noop
fzf_default_completion=tv-noop

# ~/.local/bin (custom scripts)
export PATH="$HOME/.local/bin:$PATH"

# libpq
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# Android
# export PATH="$HOME/Library/Android/sdk/platform-tools:$PATH"
# export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_NDK_HOME=$ANDROID_HOME/ndk/25.2.9519653
export NDK_HOME=$ANDROID_HOME/ndk/25.2.9519653
alias adb='HOME="$XDG_DATA_HOME"/android adb'

# OpenSSL
export OPENSSL_LIB_DIR="/opt/homebrew/opt/openssl@3/lib"
export OPENSSL_INCLUDE_DIR="/opt/homebrew/opt/openssl@3/include"
export OPENSSL_DIR="/opt/homebrew/opt/openssl@3"

# .NET Core SDK tools
export PATH="$PATH:$HOME/.dotnet/tools"

# 1password cli
source $HOME/.config/op/plugins.sh
source ~/.op/plugins.sh
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Ruby
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"

# pnpm
#
# 🔴 pnpm v11 でグローバル bin の置き場が $PNPM_HOME から $PNPM_HOME/bin に移った。
#    PATH に入れるのは **$PNPM_HOME/bin** のほう。$PNPM_HOME だけだと
#    `pnpm link --global` が "The configured global bin directory ... is not in PATH" で失敗する。
#    https://pnpm.io/global-packages
#
# ⚠️ `pnpm setup` を実行しないこと。このファイルの実体（~/.config/zsh/.zshrc）を直接書き換えるので、
#    chezmoi ソースと食い違い、次の `chezmoi apply` で消える。直すのは常にこのソース側。
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# zoxide
eval "$(zoxide init zsh)"

# sccache(Rust cache compiler)
# export RUSTC_WRAPPER=/opt/homebrew/bin/sccache

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"; fi

# mise。brew 版と ~/.local/bin の installer 版のどちらでも動くよう PATH で解決する。
# 絶対パスを直書きすると、そのパスが無いマシンで node / pnpm / java / deno が
# 有効にならないまま起動してしまう。
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Shopify Hydrogen alias to local projects
alias h2='$(npm prefix -s)/node_modules/.bin/shopify hydrogen'

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
# BUN_INSTALL はインストール先のルートを指す。bin を付けると $BUN_INSTALL/bin が
# 二重になる。
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section

# SuperCollider
source ${HOME}/.ghcup/env
alias sclang="/Applications/SuperCollider.app/Contents/MacOS/sclang"
alias scsynth="/Applications/SuperCollider.app/Contents/Resources/scsynth"

# Tailscale (App Store 版 GUI アプリ同梱の CLI)
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# claude code — herdr セッションごとに AI 環境を切り替え
# herdr は全ペインの環境に $HERDR_SESSION を注入する（素の claude も継承。-p / --resume でも有効）。
# 環境定義は ~/.config/chezmoi/private-data.toml の [[data.environments]] にあり、
# agent-environments.zsh は chezmoi が生成する。環境を増やすときは定義を足すだけでよい。
[[ -r "$XDG_CONFIG_HOME/zsh/agent-environments.zsh" ]] && source "$XDG_CONFIG_HOME/zsh/agent-environments.zsh"

export EDITOR="nvim"

# television shorthand
alias t='tv'
# herdr セッション一覧から選んで attach
alias ss='tv herdr-sessions'

# fvm
export PATH="$HOME/fvm/bin:$PATH"

. "$HOME/.local/share/../bin/env"


# worktrunk (wt) — git worktree manager。ディレクトリ移動と補完に必要
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
