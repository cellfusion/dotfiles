# skhd 設定 — aerospace のキー体系をそのまま移植したもの
#
# フェーズ1 (SIP 有効) では以下が使えない:
#   - alt - 0..9        スペース切替      → macOS 標準の ctrl - 1..9 を使う
#   - alt + shift - 0..9 ウィンドウを移動 → scripting addition が必要
# SIP を部分無効化したら、ファイル末尾のブロックのコメントを外す。

# --- フォーカス移動 -----------------------------------------------------
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# --- ウィンドウの入れ替え -----------------------------------------------
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# --- ウィンドウの再配置 (join-with 相当) --------------------------------
# swap が位置の交換なのに対し、warp は分割ツリー内での付け替え
alt + shift + ctrl - h : yabai -m window --warp west
alt + shift + ctrl - j : yabai -m window --warp south
alt + shift + ctrl - k : yabai -m window --warp north
alt + shift + ctrl - l : yabai -m window --warp east

# --- リサイズ -----------------------------------------------------------
# aerospace の alt - comma / period に相当。伸ばす方向は自動で選ばれないため
# 右下方向を基準にし、端のウィンドウでは左上方向にフォールバックする
# skhd は記号をキーリテラルで書けないので keycode 指定にしている
# (0x2B = comma, 0x2F = period, 0x2C = slash, 0x29 = semicolon)
alt - 0x2B  : yabai -m window --resize right:-50:0 || yabai -m window --resize left:-50:0
alt - 0x2F : yabai -m window --resize right:50:0  || yabai -m window --resize left:50:0

alt + shift - 0x2B  : yabai -m window --resize bottom:0:-50 || yabai -m window --resize top:0:-50
alt + shift - 0x2F : yabai -m window --resize bottom:0:50  || yabai -m window --resize top:0:50

# 分割を均等に戻す
alt + shift - 0 : yabai -m space --balance

# --- レイアウト操作 (yabai の得意分野) ----------------------------------
# 分割ツリーを回転・反転する
alt - r         : yabai -m space --rotate 90
alt + shift - r : yabai -m space --rotate 270
alt - x         : yabai -m space --mirror x-axis
alt - y         : yabai -m space --mirror y-axis

# 次に開くウィンドウの分割方向を明示する
alt - v : yabai -m window --insert east
alt - s : yabai -m window --insert south
alt - q : yabai -m window --insert stack

# stack レイアウト内のウィンドウ切替 (重なった中の前/次を表示)
alt - p : yabai -m window --focus stack.prev
alt - n : yabai -m window --focus stack.next

# フロート切替と中央寄せ
alt + shift - f : yabai -m window --toggle float
alt + shift - c : yabai -m window --toggle float \
                  && yabai -m window --grid 8:8:1:1:6:6

# 全画面化 (macOS のフルスクリーンではなくスペース内での最大化)
alt - f : yabai -m window --toggle zoom-fullscreen
alt - m : yabai -m window --toggle zoom-parent

# スペース全体のレイアウトを切り替える (aerospace の alt+shift+slash 相当)
alt + shift - 0x2C : yabai -m space --layout "$(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "float" else "bsp" end')"

# --- 設定の再読み込み ---------------------------------------------------
alt + shift - 0x29 : yabai --restart-service && skhd --restart-service

# --- スペース切替 -------------------------------------------------------
# asmvik/yabai v7.1.19+ で space --focus が SIP 有効のまま動く
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9

# --- ウィンドウを別スペースへ移動 (フォーカスも追従) -------------------
# asmvik/yabai v7.1.25+ で window --space が SIP 有効のまま動く。
# window --space ... --focus は組み合わせで不安定なため、移動と space
# フォーカスを別コマンドに分けている (issue #2788 の workaround)
alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space 7; yabai -m space --focus 7
alt + shift - 8 : yabai -m window --space 8; yabai -m space --focus 8
alt + shift - 9 : yabai -m window --space 9; yabai -m space --focus 9

# --- モニタ間フォーカス移動 ---------------------------------------------
alt + ctrl - h : yabai -m display --focus west
alt + ctrl - l : yabai -m display --focus east
