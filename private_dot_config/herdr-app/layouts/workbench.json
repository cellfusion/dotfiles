{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "preview": "layouts/workbench.svg",
  "theme": "workbench-tokyonight",
  "background": "canvas",
  "terminal_padding": [12, 10],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "window_drag": true, "content": { "mod": "workbench-chrome", "props": { "mode": "brand" } } },
        { "id": "projects", "type": "block", "content": { "mod": "workbench-navigator" } },
        { "id": "workbench-usage", "type": "block", "size": { "px": 168 }, "min": 64, "max": 360, "content": { "mod": "workbench-usage", "props": { "mode": "sidebar" } } },
        { "id": "sidebar-settings", "type": "block", "size": { "px": 72 }, "resizable": false, "content": { "mod": "workspace-chrome", "props": { "footer": true } } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 42 },
          "window_drag": true,
          "content": { "mod": "tabs" }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "workspace",
              "type": "block",
              "min": 360,
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 5,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "header": {
                    "content": { "mod": "pane" },
                    "height": 28,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "footer",
          "type": "row",
          "size": { "px": 32 },
          "resizable": false,
          "children": [
            { "id": "workbench-status", "type": "block", "content": { "mod": "workbench-chrome" } }
          ]
        }
      ]
    }
  ]
}
