#!/bin/sh
# 共通の収集結果だけを読む。収集や履歴走査は行わない。
set -u
reader="$HOME/.local/lib/agent-usage/sketchybar.sh"
{{- $envs := list (dict "session" "default" "label" "P1" "agents" (list "claude" "codex")) -}}
{{- if hasKey . "environments" }}{{ $envs = .environments }}{{ end }}
{{- range $env := $envs }}
{{- if has "claude" $env.agents }}
sh "$reader" {{ $env.session | quote }} "claude" {{ $env.label | quote }}
{{- end }}
{{- if has "codex" $env.agents }}
sh "$reader" {{ $env.session | quote }} "codex" {{ $env.label | quote }}
{{- end }}
{{- end }}
