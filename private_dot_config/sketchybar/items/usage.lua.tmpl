{{- $envs := list (dict "session" "default" "label" "P1" "agents" (list "claude" "codex")) -}}
{{- if hasKey . "environments" }}{{ $envs = .environments }}{{ end -}}
local colors = require("colors")
local settings = require("settings")
local app_icons = require("helpers.app_icons")

local severity_color = {
	crit = colors.red,
	warn = colors.yellow,
	ok = colors.green,
	none = colors.grey,
}

local agent_specs = {
{{- range $i, $env := $envs }}
{{- if has "claude" $env.agents }}
	{
		env_key = "{{ $env.session }}",
		environment = "{{ $env.label }}",
		agent = "claude",
		label = "Claude",
		name = "widgets.usage.{{ $env.session }}.claude",
		popup_name = "widgets.usage.popup.{{ $env.session }}.claude",
		env_popup_name = "widgets.usage.popup.env.{{ $env.session }}",
		icon = app_icons["Claude"],
	},
{{- end }}
{{- if has "codex" $env.agents }}
	{
		env_key = "{{ $env.session }}",
		environment = "{{ $env.label }}",
		agent = "codex",
		label = "Codex",
		name = "widgets.usage.{{ $env.session }}.codex",
		popup_name = "widgets.usage.popup.{{ $env.session }}.codex",
		env_popup_name = "widgets.usage.popup.env.{{ $env.session }}",
		icon = app_icons["ChatGPT"],
	},
{{- end }}
{{- end }}
}

-- どの環境も agent を持たないなら、ウィジェットを描画しない。
if #agent_specs == 0 then
	return
end

-- 更新イベントを購読する項目は 1 つでよい。最初の agent 項目に持たせる。
agent_specs[1].update_freq = 120

local records = {}
local function empty_record()
	return {
		used_pct = "-",
		resets_at = "-",
		status = "error",
		severity = "none",
		session_pct = "-",
		session_resets_at = "-",
		session_severity = "none",
	}
end

for _, spec in ipairs(agent_specs) do
	records[spec.environment .. "\t" .. spec.agent] = empty_record()
end

local function add_caption(name, string)
	return sbar.add("item", name, {
		position = "right",
		icon = { drawing = false },
		label = {
			string = string,
			color = colors.grey,
			font = { family = settings.font.text, style = settings.font.style_map["Semibold"] },
			padding_left = 4,
			padding_right = 4,
		},
	})
end

local function add_agent(spec)
	local options = {
		position = "right",
		icon = {
			string = spec.icon,
			font = "sketchybar-app-font:Regular:16.0",
			color = colors.grey,
			padding_left = 4,
			padding_right = 2,
		},
		label = {
			string = "--%",
			color = colors.grey,
			font = { family = settings.font.text, style = settings.font.style_map["Semibold"] },
			padding_left = 2,
			padding_right = 4,
		},
	}
	if spec.update_freq then
		options.update_freq = spec.update_freq
	end
	return sbar.add("item", spec.name, options)
end

-- 左から右へ「<環境ラベル> [Claude] 64% [Codex] 20% | <環境ラベル> …」と並べる計画を作る。
local display_plan = {}
local last_env = nil
for _, spec in ipairs(agent_specs) do
	if spec.env_key ~= last_env then
		if last_env ~= nil then
			table.insert(display_plan, { kind = "separator" })
		end
		table.insert(display_plan, { kind = "caption", spec = spec })
		last_env = spec.env_key
	end
	table.insert(display_plan, { kind = "agent", spec = spec })
end

-- sketchybar の position="right" は後から add したものを既存項目の左へ置く。
-- 上の計画どおりに並べるには、末尾から add する。
local display_items = {}
local items_by_key = {}
for i = #display_plan, 1, -1 do
	local entry = display_plan[i]
	local item
	if entry.kind == "separator" then
		item = add_caption("widgets.usage.separator." .. i, "|")
	elseif entry.kind == "caption" then
		item = add_caption("widgets.usage.env." .. entry.spec.env_key, entry.spec.environment)
	else
		item = add_agent(entry.spec)
		items_by_key[entry.spec.environment .. "\t" .. entry.spec.agent] = item
	end
	display_items[i] = item
end

local bracket_names = {}
for i = 1, #display_plan do
	bracket_names[i] = display_items[i].name
end

local usage_bracket = sbar.add("bracket", "widgets.usage.bracket", bracket_names, {
	background = { color = colors.bg1, height = 32 },
	popup = { align = "center" },
})

sbar.add("item", "widgets.usage.padding", {
	position = "right",
	width = settings.group_paddings,
})

local popup_width = 400
local popup_items = {}
local popup_last_env = nil
for _, spec in ipairs(agent_specs) do
	-- popup の行は add した順に上から並ぶ。環境の切れ目で見出し行を先に置く。
	if spec.env_key ~= popup_last_env then
		sbar.add("item", spec.env_popup_name, {
			position = "popup." .. usage_bracket.name,
			icon = { drawing = false },
			label = {
				string = spec.environment,
				color = colors.grey,
				align = "left",
				width = popup_width,
				font = { family = settings.font.text, style = settings.font.style_map["Bold"] },
			},
		})
		popup_last_env = spec.env_key
	end
	popup_items[spec.environment .. "\t" .. spec.agent] = sbar.add("item", spec.popup_name, {
		position = "popup." .. usage_bracket.name,
		icon = {
			string = string.format("%-8s5h %4s  %s", spec.label, "--%", "--"),
			color = colors.grey,
			align = "left",
			width = popup_width / 2,
			font = { family = settings.font.numbers, style = settings.font.style_map["Regular"] },
		},
		label = {
			string = string.format("7d %4s  %s", "--%", "error"),
			color = colors.grey,
			align = "right",
			width = popup_width / 2,
			font = { family = settings.font.numbers, style = settings.font.style_map["Regular"] },
		},
	})
end

local function parse_records(result)
	for _, spec in ipairs(agent_specs) do
		records[spec.environment .. "\t" .. spec.agent] = empty_record()
	end
	for line in (result or ""):gmatch("[^\n]+") do
		local environment, agent, used_pct, resets_at, status, severity, session_pct, session_resets_at, session_severity =
			line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)$")
		if environment and records[environment .. "\t" .. agent] then
			records[environment .. "\t" .. agent] = {
				used_pct = used_pct ~= "" and used_pct or "-",
				resets_at = resets_at ~= "" and resets_at or "-",
				status = status ~= "" and status or "error",
				severity = severity ~= "" and severity or "none",
				session_pct = session_pct ~= "" and session_pct or "-",
				session_resets_at = session_resets_at ~= "" and session_resets_at or "-",
				session_severity = session_severity ~= "" and session_severity or "none",
			}
		end
	end
end

local function format_usage(used_pct)
	if used_pct == "-" or used_pct == "" then
		return "--%"
	end
	return used_pct .. "%"
end

-- 週次と 5 時間で severity が別なので、status と severity を引数に取る。
local function color_of(status, severity)
	if status ~= "ok" then
		return colors.grey
	end
	return severity_color[severity] or colors.grey
end

local function color_for(record)
	return color_of(record.status, record.severity)
end

local function format_remaining(resets_at, now)
	local reset = tonumber(resets_at)
	if not reset then
		return "--"
	end

	local remaining = math.max(0, reset - now)
	if remaining >= 86400 then
		return math.floor(remaining / 86400) .. "d" .. math.floor((remaining % 86400) / 3600) .. "h"
	end
	return math.floor(remaining / 3600) .. "h" .. math.floor((remaining % 3600) / 60) .. "m"
end

local function format_reset(resets_at)
	local reset = tonumber(resets_at)
	if not reset then
		return "--"
	end
	return os.date("%m/%d %H:%M", reset)
end

local function update_display(spec, item)
	local record = records[spec.environment .. "\t" .. spec.agent]
	item:set({
		icon = { color = color_of(record.status, record.session_severity) },
		label = { string = format_usage(record.used_pct), color = color_for(record) },
	})
end

local function update_popup(spec)
	local key = spec.environment .. "\t" .. spec.agent
	local record = records[key]
	local now = os.time()
	-- status が ok でない行は数値を描かず、右の列に stale か error を出す。
	local session_usage, remaining = "--%", "--"
	local week_usage, week_reset = "--%", record.status
	if record.status == "ok" then
		session_usage = format_usage(record.session_pct)
		remaining = format_remaining(record.session_resets_at, now)
		week_usage = format_usage(record.used_pct)
		week_reset = format_reset(record.resets_at)
	end
	popup_items[key]:set({
		icon = {
			string = string.format("%-8s5h %4s  %s", spec.label, session_usage, remaining),
			color = color_of(record.status, record.session_severity),
		},
		label = {
			string = string.format("7d %4s  %s", week_usage, week_reset),
			color = color_of(record.status, record.severity),
		},
	})
end

local function update()
	sbar.exec("$CONFIG_DIR/helpers/usage.sh", function(result)
		parse_records(result)
		for _, spec in ipairs(agent_specs) do
			local item = items_by_key[spec.environment .. "\t" .. spec.agent]
			if item then
				update_display(spec, item)
			end
			update_popup(spec)
		end
	end)
end

-- bracket 自体はマウスの入力を受け取らないので、bracket に入っている各項目が
-- クリックを受ける。開いた popup はマウスの位置では閉じない。
local function toggle_popup()
	update()
	usage_bracket:set({ popup = { drawing = "toggle" } })
end

for _, item in ipairs(display_items) do
	item:subscribe("mouse.clicked", toggle_popup)
end

items_by_key[agent_specs[1].environment .. "\t" .. agent_specs[1].agent]
	:subscribe({ "forced", "routine", "system_woke" }, update)
