#!/usr/bin/env node
'use strict'

const fs = require('node:fs')
const path = require('node:path')
const { spawnSync } = require('node:child_process')
const { COMPLEXITIES, parsePlan, dependencyWaves } = require('./mad-plan-parser.js')

const ROLE_NAMES = ['plan-auditor', 'implementer', 'task-reviewer', 're-reviewer', 'final-reviewer']
const COMPLEXITY_RANK = new Map(COMPLEXITIES.map((complexity, index) => [complexity, index]))

function fail(message) {
  process.stderr.write(`mad-run: ${message}\n`)
  process.exit(2)
}

function requireAbsolute(value, label) {
  if (typeof value !== 'string' || !path.isAbsolute(value)) fail(`${label} must be absolute`)
  return value
}

function requireRegularFile(value, label) {
  requireAbsolute(value, label)
  if (!fs.statSync(value, { throwIfNoEntry: false })?.isFile()) fail(`${label} is not a regular file`)
  return value
}

function parseOptions(argv) {
  const options = { backend: 'paseo-cli', dryRun: false }
  const valueOptions = new Set(['--plan', '--project', '--run-id', '--backend', '--config', '--snapshot'])
  for (let index = 0; index < argv.length; index += 1) {
    const token = argv[index]
    if (token === '--dry-run') {
      options.dryRun = true
      continue
    }
    if (!valueOptions.has(token)) fail(`unknown argument: ${token}`)
    const value = argv[index + 1]
    if (value === undefined || value.startsWith('--')) fail(`${token} requires a value`)
    index += 1
    if (token === '--plan') options.plan = value
    if (token === '--project') options.project = value
    if (token === '--run-id') options.runId = value
    if (token === '--backend') options.backend = value
    if (token === '--config') options.config = value
    if (token === '--snapshot') options.snapshot = value
  }
  if (!options.dryRun) fail('only --dry-run is implemented')
  for (const key of ['plan', 'project', 'runId', 'config', 'snapshot']) {
    if (options[key] === undefined) fail(`--${key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)} is required`)
  }
  if (!['paseo-cli', 'paseo-mcp'].includes(options.backend)) fail('backend must be paseo-cli or paseo-mcp')
  if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(options.runId)) fail('run-id is not safe')
  return options
}

function roleCatalog() {
  const roleRoot = process.env.MAD_ROLE_ROOT || path.resolve(__dirname, '../../../agent-defs')
  const roles = {}
  for (const role of ROLE_NAMES) {
    const prompt = path.join(roleRoot, 'prompts', `${role}.md`)
    const schema = path.join(roleRoot, 'schemas', `${role}.json`)
    if (!fs.statSync(prompt, { throwIfNoEntry: false })?.isFile()) fail(`role prompt is missing: ${role}`)
    if (!fs.statSync(schema, { throwIfNoEntry: false })?.isFile()) fail(`role schema is missing: ${role}`)
    roles[role] = { prompt, schema }
  }
  return roles
}

function generatorPath() {
  const configured = process.env.MAD_GENERATOR
  if (configured !== undefined) return requireAbsolute(configured, 'MAD_GENERATOR')
  if (typeof process.env.HOME !== 'string' || !path.isAbsolute(process.env.HOME)) fail('HOME must be absolute')
  return path.join(process.env.HOME, '.local/bin/agent-config')
}

function resolveLaunch(options, node) {
  const generator = generatorPath()
  const args = [
    '--input', options.config,
    'resolve',
    '--project', options.project,
    '--role', node.role,
    '--provenance', node.provenance,
    '--complexity', node.complexity,
    '--round', String(node.round),
    '--snapshot', options.snapshot,
  ]
  if (node.workClass !== undefined) args.push('--work-class', node.workClass)
  if (options.backend === 'paseo-cli') args.push('--backend', options.backend)

  const result = spawnSync(generator, args, { encoding: 'utf8' })
  if (result.error !== undefined) fail(`${node.id}: generator failed (${result.error.message})`)
  const stdout = (result.stdout || '').trim()
  const documents = stdout.length === 0 ? [] : stdout.split(/\r?\n/).filter(Boolean)
  if (documents.length !== 1) fail(`${node.id}: generator returned ${documents.length} JSON documents`)

  let launch
  try {
    launch = JSON.parse(documents[0])
  } catch {
    fail(`${node.id}: generator returned invalid JSON`)
  }
  if (result.status !== 0) {
    const detail = (result.stderr || '').trim().split(/\r?\n/).filter(Boolean).at(-1) || `exit ${result.status}`
    fail(`${node.id}: launch unresolved (${detail})`)
  }
  if (launch.type !== 'mad-launch-spec' || launch.status !== 'ok') fail(`${node.id}: generator returned a non-success launch`)
  return {
    ...node,
    status: launch.status,
    provider: launch.provider,
    model: launch.model,
    modeId: launch.modeId,
    thinkingOptionId: launch.thinkingOptionId,
    features: launch.features,
    warnings: launch.warnings,
  }
}

function maxTask(tasks) {
  return [...tasks.values()].reduce((current, task) => {
    if (current === null || COMPLEXITY_RANK.get(task.complexity) > COMPLEXITY_RANK.get(current.complexity)) return task
    return current
  }, null)
}

function makeLaunchNodes(tasks) {
  const highest = maxTask(tasks)
  const nodes = [{
    id: 'plan-auditor',
    role: 'plan-auditor',
    provenance: 'mad-dispatch',
    complexity: highest.complexity,
    round: 0,
  }]
  const orderedTasks = [...tasks.values()].sort((left, right) => left.number - right.number)
  for (const task of orderedTasks) {
    nodes.push({
      id: `task-${task.number}-implementer`,
      role: 'implementer',
      provenance: 'mad-dispatch',
      complexity: task.complexity,
      workClass: task.workClass,
      round: 0,
    })
    nodes.push({
      id: `task-${task.number}-reviewer`,
      role: 'task-reviewer',
      provenance: 'mad-review',
      complexity: task.complexity,
      workClass: task.workClass,
      round: 0,
    })
    nodes.push({
      id: `task-${task.number}-re-reviewer`,
      role: 're-reviewer',
      provenance: 'mad-review',
      complexity: task.complexity,
      workClass: task.workClass,
      round: 1,
    })
  }
  nodes.push({
    id: 'final-reviewer',
    role: 'final-reviewer',
    provenance: 'mad-review',
    complexity: highest.complexity,
    workClass: highest.workClass,
    round: 0,
  })
  return nodes
}

function main(argv) {
  const options = parseOptions(argv)
  const planPath = requireRegularFile(options.plan, 'plan')
  const project = requireAbsolute(options.project, 'project')
  if (!fs.statSync(project, { throwIfNoEntry: false })?.isDirectory()) fail('project is not a directory')
  const config = requireRegularFile(options.config, 'config')
  const snapshot = requireRegularFile(options.snapshot, 'snapshot')

  const plan = parsePlan(fs.readFileSync(planPath, 'utf8'))
  const waves = dependencyWaves(plan.tasks)
  const roles = roleCatalog()
  const launches = makeLaunchNodes(plan.tasks).map((node) => resolveLaunch({ ...options, project, config, snapshot }, node))
  const outputWaves = [...waves].map(([depth, waveTasks]) => ({
    wave: depth + 1,
    tasks: waveTasks.map((task) => ({
      number: task.number,
      complexity: task.complexity,
      workClass: task.workClass,
      nodes: ['implementer', 'task-reviewer'],
      conditionalNodes: ['re-reviewer'],
    })),
  }))

  for (const warning of plan.warnings) process.stderr.write(`mad-run: ${warning}\n`)
  process.stdout.write(`${JSON.stringify({
    version: 1,
    type: 'mad-dry-run',
    runId: options.runId,
    recipe: 'delivery',
    backend: options.backend,
    project,
    plan: planPath,
    config,
    snapshot,
    liveCalls: 0,
    applyCalls: 0,
    roles,
    launches,
    waves: outputWaves,
  })}\n`)
}

try {
  main(process.argv.slice(2))
} catch (error) {
  if (error && error.code === 'ENOENT') fail('required file is missing')
  fail(error instanceof Error ? error.message : 'invalid input')
}
