#!/usr/bin/env bash
# レシピを 1 本実行する。run ディレクトリを作り、引数を渡し、成果物をそこに残す。
set -u

SCRIPTS="$(cd "$(dirname "$0")" && pwd)"
RECIPES="${MAD_RECIPES_DIR:-$SCRIPTS/../recipes}"
GIT="${MAD_GIT_BIN:-git}"

recipe="${1:-}"
if [ -z "$recipe" ]; then
  # レシピごとに宣言を読み、名前と引数を出す。
  list_recipes() {
    local f name spec req opt
    printf 'usage: mad-run <recipe> [--arg k=v ...] [--dry-run] [--detach] [--timeout 秒] [--max-parallel N]\n\n'
    printf 'レシピ:\n'
    for f in "$RECIPES"/*.sh; do
      [ -f "$f" ] || continue
      name="$(basename "$f" .sh)"
      spec="$(MAD_SPEC_ONLY=1 MAD_RUN_DIR=/dev/null MAD_SCRIPTS="$SCRIPTS" \
        bash "$f" 2>/dev/null)"
      req="$(printf '%s\n' "$spec" | sed -n 's/^required=//p')"
      opt="$(printf '%s\n' "$spec" | sed -n 's/^optional=//p')"
      printf '  %s\n    必須: %s\n    省略可: %s\n' \
        "$name" "${req:-なし}" "${opt:-なし}"
    done
  }
  list_recipes
  exit 2
fi
shift

if [ ! -f "$RECIPES/$recipe.sh" ]; then
  printf 'mad-run: 未知のレシピ %s\n' "$recipe" >&2
  exit 2
fi

# 値を取る引数は、値が無ければ 2 で終わる。shift 2 が空回りして無限ループになるのを防ぐ。
need_value() {
  [ $# -ge 2 ] || { printf 'mad-run: %s には値が要る\n' "$1" >&2; exit 2; }
}

args='{}'
dry=0
detach=0
timeout=1200
timeout_explicit=0
max_parallel=4
while [ $# -gt 0 ]; do
  case "$1" in
    --arg)
      need_value "$@"
      kv="$2"
      case "$kv" in
        *=*) ;;
        *) printf 'mad-run: --arg は k=v の形で渡す\n' >&2; exit 2 ;;
      esac
      args="$(printf '%s' "$args" |
        jq -c --arg k "${kv%%=*}" --arg v "${kv#*=}" '.[$k] = $v')"
      shift 2 ;;
    --dry-run) dry=1; shift ;;
    --detach) detach=1; shift ;;
    --timeout) need_value "$@"; timeout="$2"; timeout_explicit=1; shift 2 ;;
    --max-parallel) need_value "$@"; max_parallel="$2"; shift 2 ;;
    *) printf 'mad-run: 未知の引数 %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [ "$detach" = "1" ] && [ "$dry" = "1" ]; then
  printf 'mad-run: --detach と --dry-run は同時に渡せない\n' >&2
  exit 2
fi

root="$("$GIT" rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"

# _cellfusion は git 追跡外の作業ディレクトリである。無ければ自己無視を置いて作る。
if [ ! -f "$root/_cellfusion/.gitignore" ]; then
  mkdir -p "$root/_cellfusion" || exit 1
  printf '*\n' > "$root/_cellfusion/.gitignore"
fi

run_id="$(date +%Y%m%dT%H%M%S)-$(od -An -tx1 -N3 /dev/urandom | tr -d ' \n')"
run_dir="$root/_cellfusion/mad/$run_id"
mkdir -p "$run_dir/.cache" || exit 1
printf '%s' "$args" > "$run_dir/args.json"

export MAD_RUN_DIR="$run_dir"
export MAD_RUN_ID="$run_id"
export MAD_TIMEOUT="$timeout"
export MAD_TIMEOUT_EXPLICIT="$timeout_explicit"
export MAD_DRY_RUN="$dry"
export MAD_SCRIPTS="$SCRIPTS"
export MAD_CACHE_DIR="$run_dir/.cache"
export MAD_MAX_PARALLEL="$max_parallel"

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

jq -n --arg recipe "$recipe" --argjson args "$args" --arg cwd "$PWD" \
  --arg base "" --arg startedAt "$(now)" \
  --argjson timeout "$timeout" --argjson maxParallel "$max_parallel" \
  '{recipe: $recipe, args: $args, cwd: $cwd, base: $base,
    startedAt: $startedAt, timeout: $timeout, maxParallel: $maxParallel}' \
  > "$run_dir/run.json" || exit 1

# レシピを走らせ、終わったら結果を残す。切り離し実行でも同じ経路を通る。
exec_recipe() {
  local st label
  bash "$RECIPES/$recipe.sh"
  st=$?
  if [ "$st" -eq 0 ]; then label=ok; else label=failed; fi
  jq -n --arg status "$label" --arg finishedAt "$(now)" --argjson exitCode "$st" \
    '{status: $status, finishedAt: $finishedAt, exitCode: $exitCode}' \
    > "$run_dir/result.json"
  return "$st"
}

printf 'mad-run: %s（run %s）\n' "$recipe" "$run_id" >&2

if [ "$detach" = "1" ]; then
  # 親が終わっても走り続ける。SIGHUP を無視して背景に置く。
  ( trap '' HUP; exec_recipe ) >"$run_dir/recipe.out" 2>"$run_dir/recipe.err" &
  printf '%s\n' "$run_id"
  exit 0
fi

exec_recipe
status=$?
if [ "$status" -ne 0 ]; then
  printf 'mad-run: 失敗した。run ディレクトリ: %s\n' "$run_dir" >&2
fi
exit "$status"
