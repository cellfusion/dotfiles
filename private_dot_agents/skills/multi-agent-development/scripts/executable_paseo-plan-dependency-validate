#!/usr/bin/env node
'use strict'

const fs = require('node:fs')
const { parsePlan, dependencyWaves } = require('./mad-plan-parser.js')

function fail(message) {
  process.stderr.write(`paseo-plan-dependency-validate: ${message}\n`)
  process.exitCode = 2
}

function main(argv) {
  const showWaves = argv[0] === '--waves'
  const planArguments = showWaves ? argv.slice(1) : argv
  if (planArguments.length !== 1) throw new Error('PLAN_FILE が 1 つ必要である')

  let text
  try {
    text = fs.readFileSync(planArguments[0], 'utf8')
  } catch {
    throw new Error('plan を読み込めない')
  }

  const plan = parsePlan(text)
  for (const warning of plan.warnings) {
    process.stderr.write(`paseo-plan-dependency-validate: ${warning}\n`)
  }
  const waves = dependencyWaves(plan.tasks)
  if (showWaves) {
    if (!plan.hasAnyDependsOn) process.stderr.write('warning: Depends on の宣言が無いため直列とみなす\n')
    for (const [depth, waveTasks] of waves) {
      const taskNumbers = waveTasks.map((task) => task.number).sort((left, right) => left - right)
      process.stdout.write(`wave ${depth + 1}: ${taskNumbers.join(' ')}\n`)
    }
  }
}

try {
  main(process.argv.slice(2))
} catch (error) {
  fail(error instanceof Error ? error.message : 'plan が不正である')
}
