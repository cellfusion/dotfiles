#!/usr/bin/env bash
# MAD の run を一覧し、詳細を出し、古いものを片付ける。
set -u

GIT="${MAD_GIT_BIN:-git}"
PASEO="${MAD_PASEO_BIN:-paseo}"

root="$("$GIT" rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
RUNS="${MAD_RUNS_DIR:-$root/_cellfusion/mad}"

usage() {
  printf 'usage: mad-runs ls\n'
  printf '       mad-runs show <runId>\n'
  printf '       mad-runs clean --older-than <日数> [--yes]\n'
}

# 値を取る引数は、値が無ければ 2 で終わる。
need_value() {
  [ $# -ge 2 ] || { printf 'mad-runs: %s には値が要る\n' "$1" >&2; exit 2; }
}

run_status() {
  if [ -f "$1/result.json" ]; then
    jq -r '.status // "unknown"' "$1/result.json" 2>/dev/null || printf 'unknown\n'
  else
    printf 'running\n'
  fi
}

cmd_ls() {
  local d id recipe status started
  [ -d "$RUNS" ] || { printf 'mad-runs: run がまだ無い（%s）\n' "$RUNS"; return 0; }
  printf 'run:\n'
  for d in $(ls -dt "$RUNS"/*/ 2>/dev/null); do
    d="${d%/}"
    id="$(basename "$d")"
    recipe="$(jq -r '.recipe // "?"' "$d/run.json" 2>/dev/null || printf '?')"
    started="$(jq -r '.startedAt // "?"' "$d/run.json" 2>/dev/null || printf '?')"
    status="$(run_status "$d")"
    printf '  %s  %s  %s  %s\n' "$id" "$recipe" "$status" "$started"
  done
}

cmd_show() {
  local id="${1-}" d f name
  [ -n "$id" ] || { printf 'mad-runs: run id が要る\n' >&2; exit 2; }
  d="$RUNS/$id"
  [ -d "$d" ] || { printf 'mad-runs: run %s が無い\n' "$id" >&2; exit 2; }
  printf 'run: %s\n' "$id"
  printf 'recipe: %s\n' "$(jq -r '.recipe // "?"' "$d/run.json" 2>/dev/null)"
  printf 'cwd: %s\n' "$(jq -r '.cwd // "?"' "$d/run.json" 2>/dev/null)"
  printf 'base: %s\n' "$(jq -r '.base // ""' "$d/run.json" 2>/dev/null)"
  printf 'status: %s\n' "$(run_status "$d")"
  printf 'args: %s\n' "$(jq -c '.args // {}' "$d/run.json" 2>/dev/null)"
  printf '\nノード:\n'
  for f in "$d"/*.state; do
    [ -f "$f" ] || continue
    printf '  %s\n' "$(basename "$f" .state)"
    sed 's/^/    /' "$f"
  done
  if [ -s "$d/workspaces.txt" ]; then
    printf '\n作った workspace:\n'
    sed 's/^/  /' "$d/workspaces.txt"
  fi
  # 失敗したノードのログの末尾だけを出す。全文は run ディレクトリにある。
  for f in "$d"/*.state; do
    [ -f "$f" ] || continue
    [ "$(sed -n 's/^state=//p' "$f")" = "failed" ] || continue
    name="$(basename "$f" .state)"
    printf '\n失敗したノード %s のログ:\n' "$name"
    tail -n 20 "$d/$name.log" 2>/dev/null | sed 's/^/  /'
  done
  # --detach した実行の標準出力は recipe.out に落ちる。最終ノードの JSON はここにしかない。
  if [ -f "$d/recipe.out" ]; then
    printf '\nレシピの出力:\n'
    sed 's/^/  /' "$d/recipe.out"
  fi
  if [ -s "$d/recipe.err" ]; then
    printf '\nレシピの標準エラー:\n'
    tail -n 20 "$d/recipe.err" | sed 's/^/  /'
  fi
}

cmd_clean() {
  local days="" yes=0 targets d id ws rest archived rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --older-than) need_value "$@"; days="$2"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) printf 'mad-runs: 未知の引数 %s\n' "$1" >&2; exit 2 ;;
    esac
  done
  [ -n "$days" ] || { printf 'mad-runs: --older-than <日数> が要る\n' >&2; exit 2; }
  [ -d "$RUNS" ] || { printf 'mad-runs: run がまだ無い（%s）\n' "$RUNS"; return 0; }

  targets="$(find "$RUNS" -mindepth 1 -maxdepth 1 -type d -mtime "+$days" 2>/dev/null)"
  if [ -z "$targets" ]; then
    printf 'mad-runs: %s 日より古い run は無い\n' "$days"
    return 0
  fi
  printf '%s 日より古い run:\n' "$days"
  for d in $targets; do
    id="$(basename "$d")"
    printf '  %s（%s）\n' "$id" "$(run_status "$d")"
    if [ -s "$d/workspaces.txt" ]; then
      while IFS="$(printf '\t')" read -r ws rest; do
        [ -n "$ws" ] && printf '    workspace %s\n' "$ws"
      done < "$d/workspaces.txt"
    fi
  done
  if [ "$yes" != "1" ]; then
    printf '\n消していない。実際に消すには --yes を付ける。\n'
    return 0
  fi
  # archive に失敗した run は残す。workspaces.txt を消すと、どの run がどの
  # workspace を作ったかの対応が失われ、後から片付けられなくなる。
  for d in $targets; do
    id="$(basename "$d")"
    archived=1
    if [ -s "$d/workspaces.txt" ]; then
      while IFS="$(printf '\t')" read -r ws rest; do
        [ -n "$ws" ] || continue
        "$PASEO" workspace archive "$ws" --json >/dev/null 2>&1 && continue
        printf 'mad-runs: workspace %s を archive できない\n' "$ws" >&2
        archived=0
      done < "$d/workspaces.txt"
    fi
    if [ "$archived" = "1" ]; then
      rm -rf "$d"
      printf 'mad-runs: %s を消した\n' "$id"
    else
      printf 'mad-runs: %s は archive に失敗したので残した\n' "$id" >&2
      rc=1
    fi
  done
  return "$rc"
}

case "${1-}" in
  ls) shift; cmd_ls "$@" ;;
  show) shift; cmd_show "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  ""|-h|--help) usage; exit 2 ;;
  *) printf 'mad-runs: 未知のサブコマンド %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
