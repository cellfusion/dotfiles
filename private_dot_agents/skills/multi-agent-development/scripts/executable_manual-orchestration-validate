#!/usr/bin/env bash
# 手動 MAD の run 成果物が、親と子の間で共有するファイル契約を満たすか検証する。
set -u

fail() {
  printf 'manual-orchestration-validate: %s\n' "$*" >&2
  exit 1
}

require_string() {
  local file="$1"
  local filter="$2"
  local field="$3"
  jq -e "$filter | strings | select(length > 0)" "$file" >/dev/null 2>&1 ||
    fail "$file: $field must be a non-empty string"
}

require_state() {
  local file="$1"
  jq -e '.state | IN("pending", "running", "waiting_for_user", "ok", "failed", "stopped", "unresolved")' \
    "$file" >/dev/null 2>&1 || fail "$file: state is invalid"
}

require_backend() {
  local file="$1"
  jq -e '.backend == "paseo-mcp"' "$file" >/dev/null 2>&1 ||
    fail "$file: backend must be paseo-mcp"
  require_string "$file" '.backend_reason' 'backend_reason'
}

require_json() {
  local file="$1"
  jq -e 'type == "object"' "$file" >/dev/null 2>&1 || fail "$file: valid JSON object is required"
}

require_string_array() {
  local file="$1"
  local filter="$2"
  local field="$3"
  jq -e "$filter | type == \"array\" and all(.[]; type == \"string\" and length > 0) and length == (unique | length)" \
    "$file" >/dev/null 2>&1 || fail "$file: $field must be an array of unique non-empty strings"
}

require_absolute_paths() {
  local file="$1"
  local filter="$2"
  local field="$3"
  jq -e "$filter | type == \"array\" and all(.[]; type == \"string\" and test(\"^/\"))" \
    "$file" >/dev/null 2>&1 || fail "$file: $field must be an array of absolute paths"
}

# 決着した state は phase_state と一致させる。実行中の run は、完了した phase を
# phase_state に残せる（delivery の spec 完了後に plan を始める間など）。
require_phase() {
  local file="$1"
  require_string "$file" '.phase' 'phase'
  jq -e '.phase_state | IN("pending", "running", "waiting_for_user", "ok", "failed", "stopped", "unresolved")' \
    "$file" >/dev/null 2>&1 || fail "$file: phase_state is invalid"
  jq -e '(.state | IN("pending", "running")) or .state == .phase_state' "$file" >/dev/null 2>&1 ||
    fail "$file: phase_state $(jq -r '.phase_state' "$file") must match state $(jq -r '.state' "$file")"
  require_string "$file" '.next_action' 'next_action'
}

require_basename_safe_id() {
  local value="$1"
  local label="$2"

  [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    fail "$label must be basename-safe"
}

require_regular_file() {
  local path="$1"
  local label="$2"

  [ -f "$path" ] && [ ! -L "$path" ] ||
    fail "$label must be an existing regular file: $path"
}

# BSD date を先に試す。macOS の date は -d を持たないので、GNU date がある環境のために
# だけ後ろへ置く。どちらも失敗したら非 0 で返し、呼び出し側が失敗として扱う。
iso8601_to_epoch() {
  local value="$1"

  date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$value" '+%s' 2>/dev/null ||
    date -u -d "$value" '+%s' 2>/dev/null
}

validate_adopted_handoff_artifacts() {
  local handoff="$1"

  jq -e '.artifact_paths | length > 0' "$handoff" >/dev/null 2>&1 ||
    fail "$handoff: adopted handoff must contain at least one artifact path"
  while IFS= read -r artifact_path; do
    require_regular_file "$artifact_path" "$handoff: adopted handoff artifact"
  done < <(jq -r '.artifact_paths[]' "$handoff")
}

require_recipe_output() {
  local recipe="$1"
  local run_state="$2"
  local required_node=""

  case "$recipe" in
    research|fanout) required_node="synthesis" ;;
    decide|debate) required_node="verdict" ;;
    spec) required_node="spec-author" ;;
    plan) required_node="planner" ;;
    implement|delivery) required_node="final-review" ;;
    review) required_node="review-synthesis" ;;
  esac

  [ -z "$required_node" ] && return
  jq -e --arg node "$required_node" '.completed_nodes | index($node) != null' "$run_state" >/dev/null 2>&1 ||
    fail "$run_state: $required_node is a required $recipe output in completed_nodes"
  jq -e --arg node "$required_node" '.adopted_attempts | has($node)' "$run_state" >/dev/null 2>&1 ||
    fail "$run_state: $required_node is a required $recipe output"
}

# implement と spike は node ごとに worktree を作る。workspaces.json はその台帳で、
# run 側だけでどの workspace を作ったか、取り込んだか、片付けたかを追えるようにする。
# この 2 つの recipe では台帳を必須にする。台帳の無い run を素通りさせると、隔離を
# 飛ばして同じ作業ディレクトリで並列に起動した run を検査が捕まえられない。
# 他の recipe は worktree を作らないので、台帳が無ければこの検査を飛ばす。
validate_workspaces() {
  local run_dir="$1"
  local run_state="$2"
  local run_status="$3"
  local recipe="$4"
  local workspaces="$run_dir/workspaces.json"
  local node_id
  local field
  local integration

  case "$recipe" in
    implement|spike)
      [ -f "$workspaces" ] ||
        fail "$workspaces: workspaces.json is required for a $recipe run" ;;
    *) [ -f "$workspaces" ] || return 0 ;;
  esac
  require_json "$workspaces"
  jq -e '.base | strings | select(length > 0)' "$run_state" >/dev/null 2>&1 ||
    fail "$run_state: base is required for a run that creates workspaces"

  while IFS= read -r node_id; do
    require_basename_safe_id "$node_id" "$workspaces: workspace node ID"
    [ -d "$run_dir/nodes/$node_id" ] || fail "$workspaces: unknown node: $node_id"
    jq -e --arg node "$node_id" '.[$node] | type == "object"' "$workspaces" >/dev/null 2>&1 ||
      fail "$workspaces: $node_id must map to a workspace object"
    for field in workspace_id cwd branch; do
      jq -e --arg node "$node_id" --arg field "$field" \
        '.[$node][$field] | strings | select(length > 0)' "$workspaces" >/dev/null 2>&1 ||
        fail "$workspaces: $node_id $field must be a non-empty string"
    done
    jq -e --arg node "$node_id" '.[$node].cwd | test("^/")' "$workspaces" >/dev/null 2>&1 ||
      fail "$workspaces: $node_id cwd must be an absolute path"
    jq -e --arg node "$node_id" '.[$node].archived | type == "boolean"' "$workspaces" >/dev/null 2>&1 ||
      fail "$workspaces: $node_id archived must be a boolean"
    # archive は worktree のディレクトリごと消す。取り込みの判断を run の完了条件に
    # しないと、上限で切られた diff.patch しか残らない実装が復元できなくなる。
    jq -e --arg node "$node_id" '.[$node].integration | IN("pending", "merged", "declined")' \
      "$workspaces" >/dev/null 2>&1 ||
      fail "$workspaces: $node_id integration must be one of pending, merged, declined"
    integration="$(jq -r --arg node "$node_id" '.[$node].integration' "$workspaces")"
    if [ "$integration" = "declined" ]; then
      jq -e --arg node "$node_id" '.[$node].integration_reason | strings | select(length > 0)' \
        "$workspaces" >/dev/null 2>&1 ||
        fail "$workspaces: $node_id integration_reason is required when integration is declined"
    fi
    # archived の要求は、取り込みの判断が済んだ後にだけ掛ける。
    if [ "$run_status" = "ok" ]; then
      [ "$integration" != "pending" ] ||
        fail "$workspaces: $node_id integration is still pending"
      jq -e --arg node "$node_id" '.[$node].archived' "$workspaces" >/dev/null 2>&1 ||
        fail "$workspaces: $node_id workspace is not archived"
    fi
  done < <(jq -r 'keys[]' "$workspaces")
}

validate_handoff() {
  local handoff="$1"
  local run_id="$2"
  local node_id="$3"
  local attempt_id="$4"

  [ -f "$handoff" ] || fail "$handoff: handoff.json is required"
  require_json "$handoff"
  require_string "$handoff" '.run_id' 'run_id'
  require_string "$handoff" '.node' 'node'
  require_string "$handoff" '.attempt' 'attempt'
  require_absolute_paths "$handoff" '.artifact_paths' 'artifact_paths'
  [ "$(jq -r '.run_id' "$handoff")" = "$run_id" ] ||
    fail "$handoff: run_id does not match run state"
  [ "$(jq -r '.node' "$handoff")" = "$node_id" ] ||
    fail "$handoff: node does not match its directory"
  [ "$(jq -r '.attempt' "$handoff")" = "$attempt_id" ] ||
    fail "$handoff: attempt does not match its directory"
}

node_is_ok() {
  local node_dir="$1"
  local node_id="$2"
  local adopted_attempt="$3"
  local attempt_state="$node_dir/attempts/$adopted_attempt/state.json"

  [ -n "$adopted_attempt" ] || return 1
  [ -f "$attempt_state" ] || return 1
  [ "$(jq -r '.node' "$attempt_state")" = "$node_id" ] || return 1
  jq -e '.state == "ok"' "$attempt_state" >/dev/null 2>&1
}

write_private_text() {
  local file="$1"
  local text="$2"
  local directory
  local basename
  local temporary
  directory="$(dirname "$file")"
  basename="$(basename "$file")"
  [ -d "$directory" ] || return 1
  [ -d "$file" ] && return 1
  temporary="$(mktemp "$directory/.${basename}.tmp.XXXXXX")" || return 1
  if ! ( umask 077; printf '%s' "$text" > "$temporary"; chmod 600 "$temporary" ); then
    rm -f "$temporary"
    return 1
  fi
  if ! mv "$temporary" "$file"; then
    rm -f "$temporary"
    return 1
  fi
  return 0
}

mad_default_share_dir() {
  [ -n "${HOME:-}" ] || return 1
  printf '%s\n' "$HOME/.local/share/agent-config"
}

mad_add_event() {
  local event="$1"
  local with_sequence
  with_sequence="$(jq -c --argjson sequence "$MAD_SEQUENCE" '. + {seq: $sequence}' <<<"$event" 2>/dev/null)" || return 1
  MAD_EVENTS="$(jq -c --argjson event "$with_sequence" '. + [$event]' <<<"$MAD_EVENTS" 2>/dev/null)" || return 1
  MAD_SEQUENCE=$((MAD_SEQUENCE + 1))
  return 0
}

mad_persist_log() {
  local value
  value="$(jq -cn --argjson events "$MAD_EVENTS" '{version:1,type:"mad-call-log",events:$events}' 2>/dev/null)" || return 1
  write_private_text "$MAD_CALL_LOG" "$value"
}

mad_persist_state() {
  local state="$1"
  local child_ref="${2:-}"
  local state_json
  if [ -n "$child_ref" ]; then
    state_json="$(jq -cn --arg state "$state" --arg childRef "$child_ref" '{state:$state,child_ref:$childRef}')" || return 1
  else
    state_json="$(jq -cn --arg state "$state" '{state:$state}')" || return 1
  fi
  write_private_text "$MAD_ATTEMPT_DIR/state.json" "$state_json"
}

mad_finish_failure() {
  local stage="$1"
  local exit_code="$2"
  local state="$3"
  local create_calls="$4"
  mad_add_event "$(jq -cn --arg stage "$stage" --argjson exitCode "$exit_code" \
    --argjson createCalls "$create_calls" --arg state "$state" \
    '{operation:"failure",stage:$stage,exitCode:$exitCode,createCalls:$createCalls,state:$state}')" || true
  mad_persist_state "$state" || true
  mad_persist_log || true
  exit "$exit_code"
}

mad_single_document() {
  printf '%s' "$1" | jq -c -s 'if length == 1 and (.[0] | type == "object") then .[0] else error end' 2>/dev/null
}

mad_accepted_child_ref() {
  local response
  response="$(mad_single_document "$1")" || return 1
  printf '%s' "$response" | jq -er '
    if type == "object" and (keys | sort) == ["childRef", "status"] and
       .status == "accepted" and (.childRef | type == "string") and
       (.childRef | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    then .childRef else error end
  ' 2>/dev/null
}

normalize_list_providers() {
  local provider_ids="$1"
  jq -c --argjson ids "$provider_ids" '
    if (type != "object" or (keys | sort) != ["providers"] or (.providers | type) != "array") then error
    elif (any(.providers[]; (type != "object" or (keys | sort) != ["available","id","modeIds"]))) then error
    elif (any(.providers[]; (.id | type != "string" or (test("^[A-Za-z0-9][A-Za-z0-9._-]*$") | not)))) then error
    elif (any(.providers[]; (.available | type != "boolean"))) then error
    elif (any(.providers[]; (.modeIds | type != "array" or any(.[]; type != "string" or length == 0)))) then error
    elif (any(.providers[]; ([.modeIds] | flatten | length) != ([.modeIds] | flatten | unique | length))) then error
    elif ([.providers[].id] | length) != ([.providers[].id] | unique | length) then error
    elif (($ids - [.providers[].id]) | length) != 0 then error
    else {providers: [.providers[] | .id as $id | select(any($ids[]; . == $id)) | {id,available,modeIds}]} end
  ' 2>/dev/null
}

normalize_list_models() {
  local provider="$1"
  jq -c --arg provider "$provider" '
    if (type != "object" or (keys | sort) != ["models","provider"] or .provider != $provider or (.models | type) != "array") then error
    elif (any(.models[]; (type != "object" or (keys | sort) != ["id","thinkingOptionIds"]))) then error
    elif (any(.models[]; (.id | type != "string" or length == 0))) then error
    elif ([.models[].id] | length) != ([.models[].id] | unique | length) then error
    elif (any(.models[]; (.thinkingOptionIds | type != "array" or any(.[]; type != "string" or length == 0)))) then error
    elif (any(.models[]; ([.thinkingOptionIds] | flatten | length) != ([.thinkingOptionIds] | flatten | unique | length))) then error
    else {provider:.provider,models:[.models[] | {id,thinkingOptionIds}]} end
  ' 2>/dev/null
}

normalize_launch_success() {
  jq -c '
    if (keys | sort) != ["environment","featureValues","modeId","model","profileName","provider","status","thinkingOptionId","tier","type","version","warnings"] then error
    elif (.version != 1 or .type != "mad-launch-spec" or .status != "ok" or .modeId != "auto") then error
    elif (any([.profileName,.environment,.provider,.model,.thinkingOptionId][]; type != "string" or length == 0)) then error
    elif ((.tier as $tier | ["deep","think","work","light"] | index($tier)) == null) then error
    elif (.featureValues | type != "object" or any(to_entries[]; (.value | (type != "boolean" and type != "string" and type != "number")))) then error
    elif (.warnings | type != "array" or any(.[]; type != "string" or contains("://"))) then error
    else . end
  ' 2>/dev/null
}

normalize_launch_failure() {
  jq -c '
    if (keys | sort) != ["candidates","environment","profileName","reasonCode","status","tier","type","version","warnings"] then error
    elif (.version != 1 or .type != "mad-launch-failure" or .status != "unresolved" or .reasonCode != "candidates_exhausted") then error
    elif (any([.profileName,.environment][]; type != "string" or length == 0)) then error
    elif ((.tier as $tier | ["deep","think","work","light"] | index($tier)) == null) then error
    elif (.warnings | type != "array" or any(.[]; type != "string" or contains("://"))) then error
    elif (.candidates | type != "array") then error
    elif (any(.candidates[]; (type != "object" or (keys | sort) != ["model","provider","reasonCode","thinkingOptionId"]))) then error
    elif (any(.candidates[]; any([.provider,.model,.thinkingOptionId][]; type != "string" or length == 0))) then error
    elif (any(.candidates[]; (.reasonCode as $reason | ["provider_missing_from_snapshot","provider_unavailable","auto_mode_unavailable","model_unavailable","thinking_option_unavailable"] | index($reason)) == null)) then error
    else . end
  ' 2>/dev/null
}

mad_assert_launch() {
  node - "$MAD_CONTRACT" "$MAD_ATTEMPT_DIR/resolved-export.json" "$MAD_ATTEMPT_DIR/launch.json" <<'NODE' >/dev/null 2>&1
const fs = require('node:fs')
const contract = require(process.argv[2])
const exporter = require(`${process.argv[2].slice(0, process.argv[2].lastIndexOf('/'))}/paseo-exporter.js`)
const resolved = JSON.parse(fs.readFileSync(process.argv[3], 'utf8'))
const launch = JSON.parse(fs.readFileSync(process.argv[4], 'utf8'))
const allowlist = exporter.featureAllowlistForProviderId(resolved, launch.provider)
contract.assertMadLaunchSpecV1(launch, allowlist)
NODE
}

mad_build_request() {
  local context_json="$1"
  MAD_CONTEXT_JSON="$context_json" node - "$MAD_CONTRACT" "$MAD_ATTEMPT_DIR/resolved-export.json" \
    "$MAD_ATTEMPT_DIR/launch.json" "$MAD_ATTEMPT_DIR/create-request.json" <<'NODE' 2>/dev/null
const fs = require('node:fs')
const contract = require(process.argv[2])
const exporter = require(`${process.argv[2].slice(0, process.argv[2].lastIndexOf('/'))}/paseo-exporter.js`)
const resolved = JSON.parse(fs.readFileSync(process.argv[3], 'utf8'))
const launch = JSON.parse(fs.readFileSync(process.argv[4], 'utf8'))
const context = JSON.parse(process.env.MAD_CONTEXT_JSON)
const allowlist = exporter.featureAllowlistForProviderId(resolved, launch.provider)
const request = contract.buildMadCreateRequestV1(launch, allowlist, context)
contract.writeMadCreateRequest0600(request, process.argv[5])
process.stdout.write(JSON.stringify({
  topLevelKeys: Object.keys(request),
  settingsKeys: Object.keys(request.settings),
  mode: 600,
  regularFile: true,
  validatedBeforeWrite: true,
}))
NODE
}

mad_require_non_empty() {
  [ -n "$2" ] || { printf 'manual-orchestration-validate: %s is required\n' "$1" >&2; return 1; }
}

mad_require_absolute() {
  case "$2" in
    /*) return 0 ;;
    *) printf 'manual-orchestration-validate: %s must be absolute\n' "$1" >&2; return 1 ;;
  esac
}

mad_exercise_create() {
  local snapshot=""
  local launch=""
  local adapter=""
  local create_log=""
  local share_dir=""
  local contract
  local validation
  local request_path
  local response
  local adapter_status
  local child_ref
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --snapshot|--launch|--adapter|--create-log|--share-dir)
        [ "$#" -ge 2 ] || { printf 'manual-orchestration-validate: option value is required\n' >&2; return 2; }
        case "$1" in
          --snapshot) snapshot="$2" ;;
          --launch) launch="$2" ;;
          --adapter) adapter="$2" ;;
          --create-log) create_log="$2" ;;
          --share-dir) share_dir="$2" ;;
        esac
        shift 2
        ;;
      *) printf 'manual-orchestration-validate: unknown exercise option\n' >&2; return 2 ;;
    esac
  done
  mad_require_non_empty --snapshot "$snapshot" || return 2
  mad_require_non_empty --launch "$launch" || return 2
  mad_require_non_empty --adapter "$adapter" || return 2
  mad_require_non_empty --create-log "$create_log" || return 2
  if [ -z "$share_dir" ]; then
    share_dir="$(mad_default_share_dir)" || return 2
  fi
  mad_require_absolute --snapshot "$snapshot" || return 2
  mad_require_absolute --launch "$launch" || return 2
  mad_require_absolute --adapter "$adapter" || return 2
  mad_require_absolute --create-log "$create_log" || return 2
  mad_require_absolute --share-dir "$share_dir" || return 2
  [ -f "$adapter" ] && [ -x "$adapter" ] || { printf 'manual-orchestration-validate: adapter is unavailable\n' >&2; return 2; }
  contract="$share_dir/mad-contract.js"
  [ -f "$contract" ] || { printf 'manual-orchestration-validate: Paseo contract is unavailable\n' >&2; return 2; }
  node -e 'require(process.argv[1])' "$contract" >/dev/null 2>&1 || {
    printf 'manual-orchestration-validate: Paseo contract could not be loaded\n' >&2
    return 2
  }
  write_private_text "$create_log" '{"version":1,"type":"mad-create-log","createCalls":0}' || return 2
  validation="$(node - "$contract" "$snapshot" "$launch" <<'NODE' 2>/dev/null
const fs = require('node:fs')
const contract = require(process.argv[2])
const exporter = require(`${process.argv[2].slice(0, process.argv[2].lastIndexOf('/'))}/paseo-exporter.js`)
const snapshot = JSON.parse(fs.readFileSync(process.argv[3], 'utf8'))
const launch = JSON.parse(fs.readFileSync(process.argv[4], 'utf8'))
exporter.assertAvailabilitySnapshot(snapshot)
contract.assertMadLaunchSpecV1(launch, {})
NODE
  )"
  validation_status=$?
  [ "$validation_status" -eq 0 ] || return 2
  request_path="${create_log}.request"
  if ! node - "$contract" "$launch" "$request_path" <<'NODE' 2>/dev/null; then
const fs = require('node:fs')
const contract = require(process.argv[2])
const launch = JSON.parse(fs.readFileSync(process.argv[3], 'utf8'))
const context = { title: 'exercise-create', workspaceId: 'exercise-create', initialPrompt: 'exercise-create', notifyOnFinish: true }
const request = contract.buildMadCreateRequestV1(launch, {}, context)
contract.writeMadCreateRequest0600(request, process.argv[4])
NODE
    rm -f "$request_path"
    return 2
  fi
  response="$(PASEO_MAD_SHARE_DIR="$share_dir" "$adapter" create-agent --request "$request_path" 2>/dev/null)"
  adapter_status=$?
  rm -f "$request_path"
  child_ref="$(mad_accepted_child_ref "$response")"
  if [ "$adapter_status" -ne 0 ] || [ -z "$child_ref" ]; then
    write_private_text "$create_log" '{"version":1,"type":"mad-create-log","createCalls":1}' || return 2
    return 1
  fi
  write_private_text "$create_log" "$(jq -cn --arg childRef "$child_ref" '{version:1,type:"mad-create-log",createCalls:1,childRef:$childRef}')" || return 2
  return 0
}

mad_exercise_success() {
  MAD_CALL_LOG=""
  local generator=""
  local share_dir=""
  local input=""
  local adapter=""
  local attempt_dir=""
  local project=""
  local role=""
  local provenance=""
  local title=""
  local workspace_id=""
  local initial_prompt=""
  local notify_raw=""
  local notify_json
  local contract
  local launch_raw
  local launch_json
  local provider_ids
  local available_ids
  local provider
  local models_raw
  local models_json
  local resolve_status
  local resolve_output
  local request_meta
  local create_response
  local create_status
  local child_ref
  local context_json
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --generator|--share-dir|--input|--adapter|--attempt-dir|--project|--role|--provenance|--title|--workspace-id|--initial-prompt|--notify-on-finish|--call-log)
        [ "$#" -ge 2 ] || { printf 'manual-orchestration-validate: option value is required\n' >&2; return 2; }
        case "$1" in
          --generator) generator="$2" ;;
          --share-dir) share_dir="$2" ;;
          --input) input="$2" ;;
          --adapter) adapter="$2" ;;
          --attempt-dir) attempt_dir="$2" ;;
          --project) project="$2" ;;
          --role) role="$2" ;;
          --provenance) provenance="$2" ;;
          --title) title="$2" ;;
          --workspace-id) workspace_id="$2" ;;
          --initial-prompt) initial_prompt="$2" ;;
          --notify-on-finish) notify_raw="$2" ;;
          --call-log) MAD_CALL_LOG="$2" ;;
        esac
        shift 2
        ;;
      *) printf 'manual-orchestration-validate: unknown exercise option\n' >&2; return 2 ;;
    esac
  done
  if [ -z "$share_dir" ]; then
    share_dir="$(mad_default_share_dir)"
  fi
  mad_require_non_empty --generator "$generator" || return 2
  mad_require_non_empty --input "$input" || return 2
  mad_require_non_empty --adapter "$adapter" || return 2
  mad_require_non_empty --attempt-dir "$attempt_dir" || return 2
  mad_require_non_empty --project "$project" || return 2
  mad_require_non_empty --role "$role" || return 2
  mad_require_non_empty --provenance "$provenance" || return 2
  mad_require_non_empty --title "$title" || return 2
  mad_require_non_empty --workspace-id "$workspace_id" || return 2
  mad_require_non_empty --initial-prompt "$initial_prompt" || return 2
  mad_require_non_empty --notify-on-finish "$notify_raw" || return 2
  mad_require_non_empty --call-log "${MAD_CALL_LOG:-}" || return 2
  mad_require_absolute --generator "$generator" || return 2
  mad_require_absolute --share-dir "$share_dir" || return 2
  mad_require_absolute --input "$input" || return 2
  mad_require_absolute --adapter "$adapter" || return 2
  mad_require_absolute --attempt-dir "$attempt_dir" || return 2
  mad_require_absolute --project "$project" || return 2
  mad_require_absolute --call-log "$MAD_CALL_LOG" || return 2
  case "$notify_raw" in
    true) notify_json=true ;;
    false) notify_json=false ;;
    *) printf 'manual-orchestration-validate: notify-on-finish must be true or false\n' >&2; return 2 ;;
  esac
  [ -f "$generator" ] || { printf 'manual-orchestration-validate: generator is unavailable\n' >&2; return 2; }
  [ -f "$input" ] || { printf 'manual-orchestration-validate: input is unavailable\n' >&2; return 2; }
  [ -f "$adapter" ] && [ -x "$adapter" ] || { printf 'manual-orchestration-validate: adapter is unavailable\n' >&2; return 2; }
  [ -d "$project" ] || { printf 'manual-orchestration-validate: project is unavailable\n' >&2; return 2; }
  mkdir -p "$attempt_dir" || return 2
  contract="$share_dir/mad-contract.js"
  MAD_ATTEMPT_DIR="$attempt_dir"
  MAD_CONTRACT="$contract"
  MAD_EVENTS='[]'
  MAD_SEQUENCE=0
  mad_persist_state pending || return 2
  mad_persist_log || return 2
  [ -f "$contract" ] && node -e 'require(process.argv[1])' "$contract" >/dev/null 2>&1 ||
    mad_finish_failure resolve 2 failed 0

  node -e 'require(process.argv[1]).writeResolvedExport0600(process.argv[2], process.argv[3])' \
    "$contract" "$input" "$attempt_dir/resolved-export.json" >/dev/null 2>&1 ||
    mad_finish_failure resolve 2 failed 0
  node -e 'require(process.argv[1]).writeProviderEnumeration0600(process.argv[2], process.argv[3])' \
    "$contract" "$attempt_dir/resolved-export.json" "$attempt_dir/provider-enumeration.json" >/dev/null 2>&1 ||
    mad_finish_failure resolve 2 failed 0
  provider_ids="$(jq -c '.providerIds' "$attempt_dir/provider-enumeration.json" 2>/dev/null)" ||
    mad_finish_failure discovery 2 waiting_for_user 0
  mad_add_event "$(jq -cn --argjson providerIds "$provider_ids" \
    '{operation:"enumerate_materialized_provider_ids",providerIds:$providerIds}')" ||
    mad_finish_failure discovery 2 waiting_for_user 0

  providers_raw="$(PASEO_MAD_SHARE_DIR="$share_dir" "$adapter" list-providers 2>/dev/null)"
  provider_status=$?
  if [ "$provider_status" -ne 0 ]; then
    mad_finish_failure discovery 2 waiting_for_user 0
  fi
  providers_raw="$(mad_single_document "$providers_raw")" ||
    mad_finish_failure discovery 2 waiting_for_user 0
  providers_json="$(printf '%s' "$providers_raw" | normalize_list_providers "$provider_ids")"
  [ -n "$providers_json" ] || mad_finish_failure discovery 2 waiting_for_user 0
  write_private_text "$attempt_dir/list-providers.json" "$providers_json" ||
    mad_finish_failure discovery 2 waiting_for_user 0
  available_ids="$(printf '%s' "$providers_json" | jq -c '[.providers[] | select(.available == true) | .id]' 2>/dev/null)" ||
    mad_finish_failure discovery 2 waiting_for_user 0
  mad_add_event "$(jq -cn --argjson materializedProviderIds "$provider_ids" \
    --argjson availableProviderIds "$available_ids" \
    '{operation:"list_providers",callCount:1,materializedProviderIds:$materializedProviderIds,availableProviderIds:$availableProviderIds}')" ||
    mad_finish_failure discovery 2 waiting_for_user 0

  while IFS= read -r provider; do
    models_raw="$(PASEO_MAD_SHARE_DIR="$share_dir" "$adapter" list-models --provider "$provider" 2>/dev/null)"
    provider_status=$?
    if [ "$provider_status" -ne 0 ]; then
      mad_finish_failure list_models 2 waiting_for_user 0
    fi
    models_raw="$(mad_single_document "$models_raw")" ||
      mad_finish_failure list_models 2 waiting_for_user 0
    models_json="$(printf '%s' "$models_raw" | normalize_list_models "$provider")"
    [ -n "$models_json" ] || mad_finish_failure list_models 2 waiting_for_user 0
    write_private_text "$attempt_dir/list-models-$provider.json" "$models_json" ||
      mad_finish_failure list_models 2 waiting_for_user 0
    mad_add_event "$(jq -cn --arg provider "$provider" \
      '{operation:"list_models",callCount:1,provider:$provider}')" ||
      mad_finish_failure list_models 2 waiting_for_user 0
  done < <(printf '%s' "$available_ids" | jq -r '.[]' 2>/dev/null)

  node -e 'require(process.argv[1]).writeAvailabilitySnapshot0600(process.argv[2], process.argv[3], process.argv[4], process.argv[5])' \
    "$contract" "$attempt_dir/provider-enumeration.json" "$attempt_dir/list-providers.json" \
    "$attempt_dir" "$attempt_dir/snapshot.json" >/dev/null 2>&1 ||
    mad_finish_failure snapshot 2 waiting_for_user 0
  mad_add_event "$(jq -cn --arg path "$attempt_dir/snapshot.json" \
    '{operation:"write_snapshot",path:$path,mode:600,regularFile:true}')" ||
    mad_finish_failure snapshot 2 waiting_for_user 0

  resolve_output="$("$generator" --input "$input" resolve --project "$project" --role "$role" \
    --provenance "$provenance" --snapshot "$attempt_dir/snapshot.json" 2>/dev/null)"
  resolve_status=$?
  case "$resolve_status" in
    0)
      launch_raw="$(mad_single_document "$resolve_output")" || mad_finish_failure resolve 2 failed 0
      launch_json="$(printf '%s' "$launch_raw" | normalize_launch_success)" ||
        mad_finish_failure launch_validation 2 failed 0
      write_private_text "$attempt_dir/launch.json" "$launch_json" ||
        mad_finish_failure launch_validation 2 failed 0
      mad_add_event "$(jq -cn '{operation:"resolve",exitCode:0,outputType:"mad-launch-spec",stdoutDocuments:1}')" ||
        mad_finish_failure resolve 2 failed 0
      mad_assert_launch || mad_finish_failure launch_validation 2 failed 0
      ;;
    4)
      launch_raw="$(mad_single_document "$resolve_output")" || mad_finish_failure resolve 4 waiting_for_user 0
      launch_json="$(printf '%s' "$launch_raw" | normalize_launch_failure)" ||
        mad_finish_failure resolve 4 waiting_for_user 0
      write_private_text "$attempt_dir/launch.json" "$launch_json" ||
        mad_finish_failure resolve 4 waiting_for_user 0
      mad_finish_failure resolve 4 waiting_for_user 0
      ;;
    *) mad_finish_failure resolve 2 failed 0 ;;
  esac

  context_json="$(jq -cn --arg title "$title" --arg workspaceId "$workspace_id" \
    --arg initialPrompt "$initial_prompt" --argjson notifyOnFinish "$notify_json" \
    '{title:$title,workspaceId:$workspaceId,initialPrompt:$initialPrompt,notifyOnFinish:$notifyOnFinish}')"
  request_meta="$(mad_build_request "$context_json")"
  [ -n "$request_meta" ] || mad_finish_failure request_build 2 failed 0
  request_meta="$(printf '%s' "$request_meta" | jq -c . 2>/dev/null)" ||
    mad_finish_failure request_build 2 failed 0
  mad_add_event "$(printf '%s' "$request_meta" | jq -c --arg path "$attempt_dir/create-request.json" \
    '. + {operation:"build_create_request",path:$path}')" ||
    mad_finish_failure request_build 2 failed 0

  create_response="$(PASEO_MAD_SHARE_DIR="$share_dir" "$adapter" create-agent --request "$attempt_dir/create-request.json" 2>/dev/null)"
  create_status=$?
  create_calls=1
  request_payload="$(jq -c . "$attempt_dir/create-request.json" 2>/dev/null)" ||
    mad_finish_failure create_agent 1 failed "$create_calls"
  mad_add_event "$(jq -cn --arg path "$attempt_dir/create-request.json" --argjson payload "$request_payload" \
    '{operation:"create_agent",callCount:1,requestPath:$path,payload:$payload}')" ||
    mad_finish_failure create_agent 1 failed "$create_calls"
  child_ref="$(mad_accepted_child_ref "$create_response")"
  if [ "$create_status" -ne 0 ] || [ -z "$child_ref" ]; then
    mad_finish_failure create_agent 1 failed "$create_calls"
  fi
  mad_persist_state running "$child_ref" || mad_finish_failure create_agent 1 failed "$create_calls"
  mad_persist_log || mad_finish_failure create_agent 1 failed "$create_calls"
  return 0
}

if [ "$#" -eq 1 ] && [ "${1:-}" = "--select-backend" ]; then
  if [ "${MANUAL_ORCHESTRATION_PASEO_MCP_AVAILABLE:-0}" = "1" ]; then
    printf '%s\n' '{"backend":"paseo-mcp","backend_reason":"Paseo MCP available"}'
    exit 0
  fi
  printf '%s\n' 'manual-orchestration-validate: paseo-mcp backend is unavailable' >&2
  exit 1
fi

if [ "$#" -ge 1 ] && [ "${1:-}" = "--exercise-success" ]; then
  shift
  mad_exercise_success "$@"
  exit $?
fi

if [ "$#" -ge 1 ] && [ "${1:-}" = "--exercise-create" ]; then
  shift
  mad_exercise_create "$@"
  exit $?
fi

[ "$#" -eq 1 ] ||
  fail 'usage: manual-orchestration-validate RUN_DIR | --select-backend | --exercise-success ... | --exercise-create ...'
run_dir="$1"
[ -d "$run_dir" ] || fail "$run_dir: run directory does not exist"
run_dir="$(cd "$run_dir" && pwd -P)"
run_state="$run_dir/state.json"
[ -f "$run_state" ] || fail "$run_state: missing run state"

require_json "$run_state"
require_string "$run_state" '.run_id' 'run_id'
require_string "$run_state" '.recipe' 'recipe'
require_state "$run_state"
require_phase "$run_state"
require_backend "$run_state"
require_string "$run_state" '.parent_decision' 'parent_decision'
require_string_array "$run_state" '.active_nodes' 'active_nodes'
require_string_array "$run_state" '.completed_nodes' 'completed_nodes'
require_absolute_paths "$run_state" '.artifact_paths' 'artifact_paths'
jq -e '.adopted_attempts | type == "object" and all(to_entries[]; (.key | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and (.value | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")))' \
  "$run_state" >/dev/null 2>&1 || fail "$run_state: adopted_attempts must map basename-safe node IDs to attempt IDs"
if jq -e 'has("decision_request")' "$run_state" >/dev/null 2>&1; then
  jq -e '.decision_request | type == "string" and test("^/")' "$run_state" >/dev/null 2>&1 ||
    fail "$run_state: decision_request must be an absolute path"
  require_regular_file "$(jq -r '.decision_request' "$run_state")" \
    "$run_state: decision_request の実体"
fi
jq -e '([.active_nodes[], .completed_nodes[]] | length) == ([.active_nodes[], .completed_nodes[]] | unique | length)' \
  "$run_state" >/dev/null 2>&1 || fail "$run_state: active_nodes and completed_nodes must not overlap"
if [ "$(jq -r '.state' "$run_state")" = "waiting_for_user" ]; then
  jq -e '.phase_state == "waiting_for_user"' "$run_state" >/dev/null 2>&1 ||
    fail "$run_state: waiting_for_user requires phase_state waiting_for_user"
fi
jq -e '.current_round | type == "number" and . >= 0 and floor == .' "$run_state" >/dev/null 2>&1 ||
  fail "$run_state: current_round must be a non-negative integer"

run_id="$(jq -r '.run_id' "$run_state")"
recipe="$(jq -r '.recipe' "$run_state")"
run_status="$(jq -r '.state' "$run_state")"
current_round="$(jq -r '.current_round' "$run_state")"
# 期限超過の判定に使う待ち時間。契約の「既定値」の表と同じで、implement と spike だけが
# 長い。親がレシピごとに指定した値は run state の child_timeout_seconds が持つ。
child_timeout=1200
case "$recipe" in
  implement|spike) child_timeout=3600 ;;
esac
if jq -e '.child_timeout_seconds | type == "number" and . > 0 and floor == .' \
  "$run_state" >/dev/null 2>&1; then
  child_timeout="$(jq -r '.child_timeout_seconds | floor' "$run_state")"
fi
has_non_ok_adopted_attempt=0
has_research_downstream=0

if [ "$run_status" = "ok" ]; then
  jq -e '(.completed_nodes | sort) == (.adopted_attempts | keys | sort)' "$run_state" >/dev/null 2>&1 ||
    fail "$run_state: completed_nodes and adopted_attempts must name the same nodes before run completion"
  jq -e '.artifact_paths | length > 0' "$run_state" >/dev/null 2>&1 ||
    fail "$run_state: completed run must contain at least one artifact path"
  while IFS= read -r artifact_path; do
    require_regular_file "$artifact_path" "$run_state: completed run artifact"
  done < <(jq -r '.artifact_paths[]' "$run_state")
  require_recipe_output "$recipe" "$run_state"
fi

if [ -d "$run_dir/nodes" ]; then
  while IFS= read -r node_dir; do
    node_id="$(basename "$node_dir")"
    require_basename_safe_id "$node_id" "$node_dir: node ID"
    [ -d "$node_dir/attempts" ] || fail "$node_dir: node artifacts must be under attempts/"
    direct_file="$(find "$node_dir" -mindepth 1 -maxdepth 1 -type f -print -quit)"
    [ -z "$direct_file" ] || fail "$direct_file: node artifacts must be under attempts/"
    direct_dir="$(find "$node_dir" -mindepth 1 -maxdepth 1 -type d ! -name attempts -print -quit)"
    [ -z "$direct_dir" ] || fail "$direct_dir: node artifacts must be under attempts/"
    if [ "$recipe" = "research" ]; then
      case "$node_id" in
        research-1|research-2|research-3) ;;
        *) has_research_downstream=1 ;;
      esac
    fi
  done < <(find "$run_dir/nodes" -mindepth 1 -maxdepth 1 -type d -print)

  # attempt は attempts/ の直下だけである。attempt が中に持つ before/ のような
  # ディレクトリを attempt とみなすと、退避した改稿前のファイルが契約違反になる。
  # 深さで attempt を決めるので、attempt の中に置けるディレクトリを before/ だけに限る。
  # 許すと、入れ子になった attempts の state.json がどの検索にも当たらなくなる。
  while IFS= read -r attempt_dir; do
    [ -f "$attempt_dir/state.json" ] || fail "$attempt_dir: state.json is required"
    nested_dir="$(find "$attempt_dir" -mindepth 1 -maxdepth 1 -type d ! -name before -print -quit)"
    [ -z "$nested_dir" ] || fail "$nested_dir: attempt directories may only contain before/"
    if [ -d "$attempt_dir/before" ]; then
      before_entry="$(find "$attempt_dir/before" -mindepth 1 ! -type f -print -quit)"
      [ -z "$before_entry" ] || fail "$before_entry: before/ must contain only regular files"
    fi
  done < <(find "$run_dir/nodes" -mindepth 3 -maxdepth 3 -type d -path '*/attempts/*' -print)

  while IFS= read -r attempt_state; do
    attempt_dir="$(dirname "$attempt_state")"
    attempt_id="$(basename "$attempt_dir")"
    node_dir="$(dirname "$(dirname "$attempt_dir")")"
    node_id="$(basename "$node_dir")"
    require_basename_safe_id "$node_id" "$attempt_state: node ID"
    require_basename_safe_id "$attempt_id" "$attempt_state: attempt ID"

    require_json "$attempt_state"
    require_state "$attempt_state"
    require_phase "$attempt_state"
    require_backend "$attempt_state"
    require_string "$attempt_state" '.run_id' 'run_id'
    require_string "$attempt_state" '.node' 'node'
    require_string "$attempt_state" '.attempt' 'attempt'
    require_string "$attempt_state" '.parent_decision' 'parent_decision'
    attempt_status="$(jq -r '.state' "$attempt_state")"
    # 子をまだ起動していない pending だけが child_ref を持たなくてよい。
    if [ "$attempt_status" != "pending" ]; then
      require_string "$attempt_state" '.child_ref' 'child_ref'
    fi
    if [ "$attempt_status" = "running" ]; then
      require_string "$attempt_state" '.started_at' 'started_at'
      attempt_started_at="$(jq -r '.started_at' "$attempt_state")"
      [[ "$attempt_started_at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
        fail "$attempt_state: started_at must match YYYY-MM-DDTHH:MM:SSZ"
      started_epoch="$(iso8601_to_epoch "$attempt_started_at")" ||
        fail "$attempt_state: started_at cannot be converted to a unix time: $attempt_started_at"
      elapsed=$(( $(date -u '+%s') - started_epoch ))
      # 期限を過ぎた running は契約違反ではなく、子が終わっていないという観測結果で
      # ある。終了コード 1 にすると、長く走る子を持つ run の検証がすべて失敗し、親が
      # 契約違反と区別できなくなる。
      if [ "$elapsed" -gt "$child_timeout" ]; then
        printf 'overdue attempt: %s/%s started_at=%s elapsed=%ss limit=%ss\n' \
          "$node_id" "$attempt_id" "$attempt_started_at" "$elapsed" "$child_timeout"
      fi
    fi
    jq -e '.round | type == "number" and . >= 0 and floor == .' "$attempt_state" >/dev/null 2>&1 ||
      fail "$attempt_state: round must be a non-negative integer"

    [ "$(jq -r '.run_id' "$attempt_state")" = "$run_id" ] ||
      fail "$attempt_state: run_id does not match run state"
    [ "$(jq -r '.node' "$attempt_state")" = "$node_id" ] ||
      fail "$attempt_state: node does not match its directory"
    [ "$(jq -r '.attempt' "$attempt_state")" = "$attempt_id" ] ||
      fail "$attempt_state: attempt does not match its directory"
    attempt_round="$(jq -r '.round' "$attempt_state")"
    [ "$attempt_round" -le "$current_round" ] ||
      fail "$attempt_state: round exceeds current_round"

    [ -f "$attempt_dir/prompt.md" ] || fail "$attempt_dir: prompt.md is required"
    result_count=0
    [ -f "$attempt_dir/result.md" ] && result_count=$((result_count + 1))
    [ -f "$attempt_dir/result.json" ] && result_count=$((result_count + 1))
    [ "$result_count" -eq 1 ] || fail "$attempt_dir: exactly one result.md or result.json is required"
    [ -f "$attempt_dir/log.md" ] || fail "$attempt_dir: log.md is required"
    validate_handoff "$attempt_dir/handoff.json" "$run_id" "$node_id" "$attempt_id"
  done < <(find "$run_dir/nodes" -mindepth 4 -maxdepth 4 -type f -path '*/attempts/*/state.json' -print)

  while IFS= read -r node_dir; do
    node_id="$(basename "$node_dir")"
    adopted_attempt="$(jq -r --arg node "$node_id" '.adopted_attempts[$node] // empty' "$run_state")"
    if [ "$run_status" = "ok" ] && [ -z "$adopted_attempt" ]; then
      fail "$run_state: $node_id requires an adopted attempt before run completion"
    fi
    if [ -n "$adopted_attempt" ] && ! node_is_ok "$node_dir" "$node_id" "$adopted_attempt"; then
      has_non_ok_adopted_attempt=1
    fi
  done < <(find "$run_dir/nodes" -mindepth 1 -maxdepth 1 -type d -print)

  while IFS=$'\t' read -r adopted_node adopted_attempt; do
    require_basename_safe_id "$adopted_node" "$run_state: adopted node ID"
    require_basename_safe_id "$adopted_attempt" "$run_state: adopted attempt ID"
    adopted_node_dir="$run_dir/nodes/$adopted_node"
    adopted_attempt_dir="$adopted_node_dir/attempts/$adopted_attempt"
    [ -d "$adopted_node_dir" ] && [ ! -L "$adopted_node_dir" ] ||
      fail "$run_state: adopted node does not exist: $adopted_node"
    [ -d "$adopted_attempt_dir" ] && [ ! -L "$adopted_attempt_dir" ] ||
      fail "$run_state: adopted attempt does not exist: $adopted_node/$adopted_attempt"
    case "$(cd "$adopted_attempt_dir" && pwd -P)" in
      "$run_dir"/nodes/*) ;;
      *) fail "$run_state: adopted attempt must remain within the run directory" ;;
    esac
    [ -f "$adopted_attempt_dir/state.json" ] ||
      fail "$run_state: adopted attempt does not exist: $adopted_node/$adopted_attempt"
    if [ "$run_status" = "ok" ]; then
      validate_adopted_handoff_artifacts "$adopted_attempt_dir/handoff.json"
    fi
  done < <(jq -r '.adopted_attempts | to_entries[] | [.key, .value] | @tsv' "$run_state")
fi

validate_workspaces "$run_dir" "$run_state" "$run_status" "$recipe"

if [ "$run_status" = "ok" ] && [ "$has_non_ok_adopted_attempt" -eq 1 ]; then
  fail "$run_state: root state ok conflicts with a non-ok adopted child state"
fi

if [ "$recipe" = "research" ]; then
  require_research_nodes=0
  [ "$run_status" = "ok" ] && require_research_nodes=1
  [ "$has_research_downstream" -eq 1 ] && require_research_nodes=1

  if [ "$require_research_nodes" -eq 1 ]; then
    for node_id in research-1 research-2 research-3; do
      node_dir="$run_dir/nodes/$node_id"
      [ -d "$node_dir" ] || fail "$run_state: $node_id is required for research"
      adopted_attempt="$(jq -r --arg node "$node_id" '.adopted_attempts[$node] // empty' "$run_state")"
      node_is_ok "$node_dir" "$node_id" "$adopted_attempt" ||
        fail "$run_state: research downstream cannot start before all research nodes are ok"
    done
  fi
fi

case "$recipe" in
  implement|refine)
    jq -e '.max_rounds | type == "number" and . > 0 and floor == .' "$run_state" >/dev/null 2>&1 ||
      fail "$run_state: max_rounds must be a positive integer"
    max_rounds="$(jq -r '.max_rounds' "$run_state")"
    [ "$current_round" -le "$max_rounds" ] ||
      fail "$run_state: current_round exceeds max_rounds"
    if [ "$current_round" -eq "$max_rounds" ] && [ "$run_status" != "ok" ] && [ "$run_status" != "unresolved" ]; then
      fail "$run_state: max_rounds reached without completion requires state unresolved"
    fi
    ;;
esac

printf 'valid manual orchestration run: %s\n' "$run_dir"
