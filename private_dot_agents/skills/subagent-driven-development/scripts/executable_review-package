#!/usr/bin/env bash
# レビュー用のパッケージを作る。コミット一覧・変更ファイルの stat・文脈付き diff を
# 1 ファイルにまとめ、reviewer が 1 回の Read で全部見られるようにする。
# 記録した BASE を使う（HEAD~1 ではない）。HEAD~1 は複数コミットのタスクで
# 最後のコミット以外を黙って落とす。
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# 既定の OUTFILE: <repo-root>/_cellfusion/sdd/<plan-basename>/review-<base7>..<head7>.diff
# （範囲ごとに名前が変わるので、fix 後の再レビューは別ファイルになる）
#
# BASE / HEAD は必ず sha に解決してから header に書く。レビュアーは header の
# 1 行目を status に写して返し、controller がそれを期待した範囲と照合する。
# レビュアーは Bash を持たないので、header に HEAD のような symbolic ref を残すと
# 解決できず、照合が必ず失敗する。
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

base_sha=$(git rev-parse --verify --quiet "$base") || { echo "bad BASE: $base" >&2; exit 2; }
head_sha=$(git rev-parse --verify --quiet "$head") || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base_sha")..$(git rev-parse --short "$head_sha").diff"
fi

{
  echo "# Review package: ${base_sha}..${head_sha}"
  echo
  echo "## Commits"
  git log --oneline "${base_sha}..${head_sha}"
  echo
  echo "## Files changed"
  git diff --stat "${base_sha}..${head_sha}"
  echo
  echo "## Diff"
  git diff -U10 "${base_sha}..${head_sha}"
} > "$out"

commits=$(git rev-list --count "${base_sha}..${head_sha}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
