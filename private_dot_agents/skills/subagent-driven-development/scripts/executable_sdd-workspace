#!/usr/bin/env bash
# 1 つのプランが使う作業ディレクトリを解決して絶対パスを出力する。
# ここに task brief / implementer report / review package / progress ledger を置く。
#
# プランごとに 1 ディレクトリ（~/docs/<owner>/<repo>/sdd/<plan-basename>/）にするのは、
# 同じ作業ツリーで続けて別のプランを流したときに、前のプランの ledger を現在の進捗と
# 読み違えて完了済みタスク列をまるごと飛ばす事故を構造的に防ぐため。
#
# 保存先はリポジトリの作業ツリーの外にある。本体チェックアウトから呼んでも worktree から
# 呼んでも同じパスになるので、plan を絶対パスで渡せばどこからでも同じ workspace を指す。
#
# task-brief と review-package が同じ場所を指すための単一の情報源。
#
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

# chezmoi ソースから直接実行して検証できるよう、配布名と source 名の両方を探す。
shared=$(cd "$(dirname "$0")/../../_shared/scripts" && pwd)
docs_script="$shared/agent-docs-dir"
[ -f "$docs_script" ] || docs_script="$shared/executable_agent-docs-dir"

dir=$(bash "$docs_script" "sdd/$slug")
mkdir -p "$dir"
cd "$dir" && pwd
