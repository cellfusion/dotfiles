#!/usr/bin/env ruby
# Resolve a GitHub repository to its unique Obsidian project and create its artifact directory.
require 'date'
require 'fileutils'
require 'open3'
require 'pathname'
require 'psych'


def fail_with(message)
  warn "agent-docs-dir: #{message}"
  exit 1
end

vault = ENV.fetch('OBSIDIAN_VAULT_PATH', File.join(ENV.fetch('HOME'), 'Obsidian', 'notes'))
fail_with('Vault path must be absolute') unless Pathname.new(vault).absolute?
fail_with("Vault does not exist: #{vault}") unless File.directory?(vault)
projects = File.join(vault, '70_projects')
fail_with("project directory is missing or a symlink: #{projects}") unless File.directory?(projects) && !File.symlink?(projects)

remote, status = Open3.capture2('git', 'remote', 'get-url', 'origin', err: File::NULL)
fail_with('Git origin is unavailable; register or identify the repository first') unless status.success?
remote = remote.strip
match = /\A(?:git@github\.com:|ssh:\/\/git@github\.com\/|https:\/\/github\.com\/)([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+?)(?:\.git)?\/?\z/i.match(remote)
fail_with('origin must be an identifiable GitHub owner/repository') unless match
owner, repo = match.captures
fail_with('invalid GitHub owner/repository') if [owner, repo].any? { |s| s == '.' || s == '..' }
slug = "#{owner}/#{repo}"

matches = []
Dir.glob(File.join(projects, '*.md')).sort.each do |file|
  next if File.symlink?(file)
  begin
    text = File.read(file, encoding: 'UTF-8')
    frontmatter = /\A---\s*\r?\n(.*?)\r?\n---(?:\r?\n|\z)/m.match(text)
    next unless frontmatter
    data = Psych.safe_load(frontmatter[1], permitted_classes: [Date, Time], aliases: false)
    next unless data.is_a?(Hash) && data['repositories']
    fail_with("repositories must be an array: #{file}") unless data['repositories'].is_a?(Array)
    data['repositories'].each do |entry|
      fail_with("repository entry must be a string: #{file}") unless entry.is_a?(String)
      normalized = entry.gsub(/\A[[:space:]\u00a0]+|[[:space:]\u00a0]+\z/, '')
      matches << [file, normalized] if normalized.casecmp?(slug)
    end
  rescue Psych::Exception, ArgumentError, EncodingError => e
    fail_with("cannot read project frontmatter in #{file}: #{e.message}")
  end
end
matches.uniq!
fail_with("no project note matches #{slug}; register it in 70_projects first") if matches.empty?
fail_with("multiple project notes match #{slug}: #{matches.map(&:first).join(', ')}") if matches.length != 1
note, canonical_slug = matches.first
components = [File.basename(note, '.md'), *canonical_slug.split('/')]
ARGV.each do |arg|
  parts = arg.split('/', -1)
  fail_with("invalid destination: #{arg}") if parts.any? { |part| part.empty? || part == '.' || part == '..' || part.match?(/[\\\x00-\x1f\x7f]/) }
  components.concat(parts)
end
components.each do |part|
  fail_with('invalid project path component') if part.empty? || part == '.' || part == '..' || part.include?('/') || part.match?(/[\\\x00-\x1f\x7f]/)
end

path = projects
components.each do |component|
  path = File.join(path, component)
  fail_with("destination contains a symlink: #{path}") if File.symlink?(path)
  begin
    Dir.mkdir(path) unless File.directory?(path)
  rescue SystemCallError => e
    fail_with("cannot create #{path}: #{e.message}")
  end
end
puts File.expand_path(path)
