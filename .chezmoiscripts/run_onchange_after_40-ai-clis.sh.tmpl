#!/usr/bin/env bash
# claude / codex を native installer で入れる。どちらも自己更新を持つので、
# 未導入のときだけ入れて、更新は各ツールに任せる。
#
# Homebrew の claude-code cask は stable チャネルを追う一方、アプリ内の更新通知は
# latest チャネルを見るため、cask に未着のバージョンを「更新あり」と表示する状態が
# 起きる。そのため brew に寄せていない。
set -eu

{{ includeTemplate "install/preamble" }}

local_bin_env

if [ -x "$HOME/.local/bin/claude" ]; then
  printf 'claude の native 実体は導入済みなので飛ばす\n'
else
  printf 'claude を native installer で入れる\n'
  curl -fsSL https://claude.ai/install.sh | bash || die 'claude の導入に失敗した'
  [ -x "$HOME/.local/bin/claude" ] || die 'claude の native 実体が見つからない'
fi

if [ -x "$HOME/.local/bin/codex" ]; then
  printf 'codex の native 実体は導入済みなので飛ばす\n'
else
  printf 'codex を native installer で入れる\n'
  curl -fsSL https://chatgpt.com/codex/install.sh | sh || die 'codex の導入に失敗した'
  [ -x "$HOME/.local/bin/codex" ] || die 'codex の native 実体が見つからない'
fi
