#!/usr/bin/env bash
set -eu

{{ includeTemplate "install/preamble" }}

bun_env
local_bin_env
command -v omp >/dev/null 2>&1 || exit 0
cd "$HOME"

install_pstack() {
  local profile=$1 plugin=pstack@pstack-claude installed marketplaces
  installed=$(omp --profile "$profile" plugin list --json)
  if printf '%s\n' "$installed" | jq -e --arg id "$plugin" \
    'any(.marketplace[]; .id == $id and any(.entries[]; .scope == "user"))' >/dev/null; then
    return
  fi

  marketplaces=$(omp --profile "$profile" plugin marketplace list)
  if ! printf '%s\n' "$marketplaces" | awk '$1 == "pstack-claude" { found = 1 } END { exit !found }'; then
    omp --profile "$profile" plugin marketplace add michael-denyer/pstack-claude
  fi
  omp --profile "$profile" plugin install "$plugin" --scope=user
}

manual_skills=$(omp --profile default config get skills.manualSkills --json | jq -ce '.value | arrays')
pxgrid_manual_skills=$(omp --profile pxgrid config get skills.manualSkills --json | jq -ce '.value | arrays')
if [ "$pxgrid_manual_skills" != "$manual_skills" ]; then
  omp --profile pxgrid config set skills.manualSkills "$manual_skills"
fi

install_pstack default
install_pstack pxgrid
