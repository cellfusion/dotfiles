#!/usr/bin/env bash
# 公式 native 配布を導入し、更新は各ツールの self-update に任せる。
# Brew の同名コマンドや mise の launcher を導入済み判定に使わない。
set -eu

{{ includeTemplate "install/preamble" }}

local_bin_env
bun_env
rust_env
local_bin="$HOME/.local/bin"
mkdir -p "$local_bin"

if [ -x "$local_bin/chezmoi" ]; then
  printf 'chezmoi の native 実体は導入済みなので飛ばす\n'
else
  printf 'chezmoi を native installer で入れる\n'
  curl -fsLS https://get.chezmoi.io | sh -s -- -b "$local_bin" \
    || die 'chezmoi の導入に失敗した'
  [ -x "$local_bin/chezmoi" ] || die 'chezmoi の native 実体が見つからない'
fi

if [ -x "$local_bin/mise" ]; then
  printf 'mise の native 実体は導入済みなので飛ばす\n'
else
  printf 'mise を native installer で入れる\n'
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$local_bin/mise" sh \
    || die 'mise の導入に失敗した'
  [ -x "$local_bin/mise" ] || die 'mise の native 実体が見つからない'
fi

if [ -x "$BUN_INSTALL/bin/bun" ]; then
  printf 'bun の native 実体は導入済みなので飛ばす\n'
else
  printf 'bun を native installer で入れる\n'
  # bun_env が導入先を先頭に置くので installer の PATH 追記は不要になる。
  curl -fsSL https://bun.sh/install | bash || die 'bun の導入に失敗した'
  [ -x "$BUN_INSTALL/bin/bun" ] || die 'bun の native 実体が見つからない'
fi

if [ -x "$local_bin/uv" ]; then
  printf 'uv の native 実体は導入済みなので飛ばす\n'
else
  printf 'uv を native installer で入れる\n'
  curl -LsSf https://astral.sh/uv/install.sh \
    | UV_INSTALL_DIR="$local_bin" UV_NO_MODIFY_PATH=1 sh \
    || die 'uv の導入に失敗した'
  [ -x "$local_bin/uv" ] || die 'uv の native 実体が見つからない'
fi

if [ -x "$CARGO_HOME/bin/rustup" ]; then
  printf 'rustup の native 実体は導入済みなので飛ばす\n'
else
  printf 'rustup を native installer で入れる\n'
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path || die 'rustup の導入に失敗した'
  [ -x "$CARGO_HOME/bin/rustup" ] || die 'rustup の native 実体が見つからない'
fi

# cargo の存在だけでは default/override toolchain が設定済みとは限らない。
if "$CARGO_HOME/bin/rustup" show active-toolchain >/dev/null 2>&1; then
  printf 'rust の選択済み toolchain は導入済みなので飛ばす\n'
else
  printf 'rust の default toolchain を入れる\n'
  "$CARGO_HOME/bin/rustup" default stable || die 'rust の toolchain 導入に失敗した'
fi

if [ -x "$local_bin/herdr" ]; then
  printf 'herdr の native 実体は導入済みなので飛ばす\n'
else
  printf 'herdr を公式 installer で入れる\n'
  curl -fsSL https://herdr.dev/install.sh | HERDR_INSTALL_DIR="$local_bin" sh \
    || die 'herdr の導入に失敗した'
  [ -x "$local_bin/herdr" ] || die 'herdr の native 実体が見つからない'
fi
