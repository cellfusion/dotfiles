#!/usr/bin/env bash
# cargo-globals.txt が変わったときだけ実行される。
# manifest hash: {{ include "private_dot_config/install/cargo-globals.txt" | sha256sum }}
set -eu

{{ includeTemplate "install/preamble" }}

rust_env

manifest="$HOME/.config/install/cargo-globals.txt"

if ! command -v cargo >/dev/null 2>&1; then
  die 'cargo が見つからない。20-runtimes が失敗している'
fi
[ -f "$manifest" ] || die "cargo-globals.txt が見つからない: $manifest"

while IFS= read -r line; do
  case "$line" in
    '' | '#'*) continue ;;
  esac
  bin="${line%%|*}"
  args="${line#*|}"
  if command -v "$bin" >/dev/null 2>&1; then
    printf '%s は導入済みなので飛ばす\n' "$bin"
    continue
  fi
  printf '%s を入れる: cargo install %s\n' "$bin" "$args"
  # shellcheck disable=SC2086
  cargo install $args || die "$bin の導入に失敗した"
done < "$manifest"
