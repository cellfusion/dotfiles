#!/usr/bin/env bash
# mise の config.toml が変わったときだけ実行される。
# manifest hash: {{ include "private_dot_config/mise/config.toml" | sha256sum }}
set -eu

{{ includeTemplate "install/preamble" }}

local_bin_env

mise="$HOME/.local/bin/mise"
[ -x "$mise" ] || die 'native mise が見つからない。20-runtimes が失敗している'
config_dir="$XDG_CONFIG_HOME/mise"
[ -f "$config_dir/config.toml" ] || die "mise の config.toml が見つからない: $config_dir"

# apply の呼び出し元 project ではなくグローバル設定から導入する。
cd "$config_dir"
rust_env
printf 'mise install を実行する\n'
"$mise" install
