#!/usr/bin/env bash
# Validate the retained environment configuration and set up shared Claude/Codex files.
#
# manifest hash: {{ list
    (include "private_dot_local/private_share/agent-config/config-validator.js")
    (include "private_dot_local/private_share/agent-config/directory-setup.js")
    (include "private_dot_local/private_share/agent-config/agent-config.schema.json")
    (include "private_dot_local/bin/executable_agent-config")
    | join "" | sha256sum }}
set -eu

{{ includeTemplate "install/preamble" }}

local_bin_env

input="$XDG_CONFIG_HOME/chezmoi/agent-config.json"

if [ -f "$input" ]; then
  if command -v mise >/dev/null 2>&1; then
    mise exec -- agent-config --input "$input" setup
  else
    agent-config --input "$input" setup
  fi
fi
