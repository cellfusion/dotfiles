{
  "version": 3,
  "defaults": { "environment": "primary" },
  "providers": {
    "claude": { "displayName": "Claude", "setup": { "configDirectoryEnv": { "CLAUDE_CONFIG_DIR": "claude" }, "directoryPattern": { "primary": "$XDG_CONFIG_HOME/claude", "nonPrimary": "$XDG_CONFIG_HOME/claude_<environment>" }, "symlinks": ["agents", "commands", "skills", "hooks", "CLAUDE.md", "settings.json"], "preservedMutable": [".claude.json"], "existingPathPolicy": "reject-real-or-wrong-symlink" } },
    "codex": { "displayName": "Codex", "setup": { "configDirectoryEnv": { "CODEX_HOME": "codex" }, "directoryPattern": { "primary": "$XDG_CONFIG_HOME/codex", "nonPrimary": "$XDG_CONFIG_HOME/codex_<environment>" }, "symlinks": ["agents", "AGENTS.md", "rules"], "preservedMutable": ["config.toml"], "existingPathPolicy": "reject-real-or-wrong-symlink" } }
  },
  "environments": {
    "primary": { "providers": ["claude", "codex"] },
    "lab": { "providers": ["claude", "codex"] }
  },
  "agentRoles": {
    "implementer": { "duty": "implement", "access": "write", "description": "実装と検証を行う", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["implementer"] },
    "task-reviewer": { "duty": "review", "access": "read", "description": "タスクの差分をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "plan-auditor": { "duty": "review", "access": "read", "description": "実装前のプラン矛盾を監査する", "artifactContract": "mad-attempt-v1", "deliveryDuties": [] },
    "intake-router": { "duty": "review", "access": "read", "description": "Classify requests into task packets", "artifactContract": "task-packet-v1", "deliveryDuties": [] },
    "architectural-implementer": { "duty": "implement", "access": "write", "description": "Execute approved architectural plans", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["architectural-implementer"] },
    "escalation-judge": { "duty": "review", "access": "read", "description": "Choose bounded escalation actions", "artifactContract": "mad-escalation-v1", "deliveryDuties": [] },
    "re-reviewer": { "duty": "review", "access": "read", "description": "指摘の解消を判定する", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "final-reviewer": { "duty": "review", "access": "read", "description": "ブランチ全体をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "spec-author": { "duty": "author", "access": "write", "description": "spec を書く", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["spec-author"] },
    "plan-author": { "duty": "author", "access": "write", "description": "実装プランを書く", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["plan-author"] },
    "synthesizer": { "duty": "synthesize", "access": "read", "description": "複数の結果を統合する", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "reviewer": { "duty": "review", "access": "read", "description": "成果物をレビューする", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["reviewer"] },
    "researcher": { "duty": "review", "access": "read", "description": "コードベースを調査する", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["researcher"] },
    "review-synthesizer": { "duty": "synthesize", "access": "read", "description": "複数のレビュー結果を統合する", "artifactContract": "mad-attempt-v1", "deliveryDuties": ["review-synthesizer"] }
  },
  "projectRouting": { "rules": [{ "name": "sample-organization", "environment": "lab", "match": { "remoteNamespace": "example.test/SampleOrg" } }] }
}
