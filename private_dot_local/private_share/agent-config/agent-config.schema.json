    "attemptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(author|implement|review|synthesize)$": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(simple|routine|complex|critical)$": {
              "type": "object",
              "required": ["levels"],
              "additionalProperties": false,
              "properties": {
                "levels": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["candidates"],
                    "additionalProperties": false,
                    "properties": {
                      "candidates": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
