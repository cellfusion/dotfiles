    "environments": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "type": "object",
          "required": ["providers"],
          "additionalProperties": false,
          "properties": {
            "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "selection": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^(author|implement|review|synthesize)$": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^(simple|routine|complex|critical)$": {
                      "type": "object",
                      "required": ["candidates"],
                      "additionalProperties": false,
                      "properties": {
                        "notes": { "type": "string", "minLength": 1 },
                        "candidates": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": ["provider", "model", "effort", "features"],
                            "additionalProperties": false,
                            "properties": {
                              "provider": { "type": "string", "minLength": 1 },
                              "model": { "type": "string", "minLength": 1 },
                              "effort": { "type": "string", "minLength": 1 },
                              "features": { "type": "object", "patternProperties": { "^[a-z][a-z0-9_-]*$": { "type": ["boolean", "string", "number"] } }, "additionalProperties": false }
