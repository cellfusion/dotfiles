                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "projectRouting": {
      "type": "object",
      "required": ["rules"],
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "environment", "match"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "environment": { "type": "string", "minLength": 1 },
              "match": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "remote": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?/[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$" },
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
