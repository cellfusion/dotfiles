{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/agent-config-v3.json",
  "title": "Claude and Codex environment configuration",
  "type": "object",
  "required": ["version", "defaults", "providers", "environments", "agentRoles", "projectRouting"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 3 },
    "defaults": {
      "type": "object", "required": ["environment"], "additionalProperties": false,
      "properties": { "environment": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" } }
    },
    "providers": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {
        "^(claude|codex)$": {
          "type": "object", "required": ["displayName", "setup"], "additionalProperties": false,
          "properties": {
            "displayName": { "type": "string", "minLength": 1 },
            "setup": {
              "type": "object",
              "required": ["configDirectoryEnv", "directoryPattern", "symlinks", "preservedMutable", "existingPathPolicy"],
              "additionalProperties": false,
              "properties": {
                "configDirectoryEnv": {
                  "type": "object", "minProperties": 1, "additionalProperties": false,
                  "patternProperties": { "^[A-Z][A-Z0-9_]*$": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
                },
                "directoryPattern": {
                  "type": "object", "required": ["primary", "nonPrimary"], "additionalProperties": false,
                  "properties": {
                    "primary": { "type": "string", "minLength": 1 },
                    "nonPrimary": { "type": "string", "minLength": 1 }
                  }
                },
                "symlinks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "preservedMutable": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "existingPathPolicy": { "const": "reject-real-or-wrong-symlink" }
              }
            }
          }
        }
      }
    },
    "environments": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "type": "object", "required": ["providers"], "additionalProperties": false,
          "properties": {
            "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["claude", "codex"] } }
          }
        }
      }
    },
    "agentRoles": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "type": "object", "required": ["access", "description", "artifactContract", "deliveryDuties"], "additionalProperties": false,
          "properties": {
            "access": { "enum": ["read", "write"] },
            "description": { "type": "string", "minLength": 1 },
            "artifactContract": { "type": "string", "minLength": 1 },
            "deliveryDuties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "duty": { "enum": ["author", "implement", "review", "synthesize"] }
          }
        }
      }
    },
    "projectRouting": {
      "type": "object", "required": ["rules"], "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "environment", "match"], "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "environment": { "type": "string", "minLength": 1 },
              "match": {
                "type": "object", "minProperties": 1, "additionalProperties": false,
                "properties": {
                  "remote": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?/[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$" },
                  "remoteNamespace": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?/[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$" },
                  "path": { "type": "string", "minLength": 1 },
                  "gitRepository": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
