          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["provider", "model", "effort", "features"],
            "additionalProperties": false,
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
