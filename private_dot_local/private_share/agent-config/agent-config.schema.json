      "type": "object",
      "required": ["author", "implement", "review", "synthesize"],
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "object",
          "required": ["simple", "routine", "complex", "critical"],
          "additionalProperties": false,
          "properties": {
