{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/agent-config-v2.json",
  "title": "Paseo agent configuration v2",
  "type": "object",
  "required": ["version", "defaults", "providers", "selection", "environments", "agentRoles", "projectRouting"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "defaults": {
      "type": "object",
      "required": ["environment", "complexity"],
      "additionalProperties": false,
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "complexity": { "const": "routine" }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "type": "object",
          "required": ["displayName", "backends", "setup", "featureAllowlist"],
          "additionalProperties": false,
          "properties": {
            "displayName": { "type": "string", "minLength": 1 },
            "backends": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "setup": {
              "type": ["object", "null"],
              "required": ["configDirectoryEnv", "directoryPattern", "symlinks", "preservedMutable", "existingPathPolicy"],
              "additionalProperties": false,
              "properties": {
                "configDirectoryEnv": {
                  "type": "object",
                  "minProperties": 1,
                  "patternProperties": {
                    "^[A-Z][A-Z0-9_]*$": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                  },
                  "additionalProperties": false
                },
                "directoryPattern": {
                  "type": "object",
                  "required": ["primary", "nonPrimary"],
                  "additionalProperties": false,
                  "properties": {
                    "primary": { "type": "string", "minLength": 1 },
                    "nonPrimary": { "type": "string", "minLength": 1 }
                  }
                },
                "symlinks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "preservedMutable": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "existingPathPolicy": { "const": "reject-real-or-wrong-symlink" }
              }
            },
            "featureAllowlist": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9_-]*$": { "enum": ["boolean", "string", "integer"] }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    },
