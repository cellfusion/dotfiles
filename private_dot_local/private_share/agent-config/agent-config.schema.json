        "^[a-z][a-z0-9_-]*$": {
          "type": "object",
          "required": ["access", "description", "artifactContract", "deliveryDuties"],
          "additionalProperties": false,
          "properties": {
            "access": { "enum": ["read", "write"] },
            "description": { "type": "string", "minLength": 1 },
            "artifactContract": { "type": "string", "minLength": 1 },
            "deliveryDuties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "duty": { "enum": ["author", "implement", "review", "synthesize"] },
            "launchPolicy": { "enum": ["selection", "routing"] }
          }
        }
      },
      "additionalProperties": false
    },
    "routingSelection": {
      "type": "object",
      "required": ["candidates"],
      "additionalProperties": false,
      "properties": {
        "notes": { "type": "string", "minLength": 1 },
