#!/usr/bin/env node
'use strict'

const fs = require('node:fs')
const path = require('node:path')
const candidates = [
  path.join(__dirname, '..', 'share', 'agent-config'),
  path.join(__dirname, '..', 'private_share', 'agent-config'),
]
const share = candidates.find((directory) => fs.existsSync(path.join(directory, 'config-validator.js'))) || candidates[0]
const { validateConfig, ConfigError } = require(path.join(share, 'config-validator.js'))
const { setupDirectories } = require(path.join(share, 'directory-setup.js'))

function absolutePath(value, label) {
  if (typeof value !== 'string' || !path.isAbsolute(value)) throw new ConfigError(`${label}: absolute path is required`)
  return value
}
function configHome() {
  return absolutePath(process.env.XDG_CONFIG_HOME || path.join(absolutePath(process.env.HOME, 'HOME'), '.config'), 'XDG_CONFIG_HOME')
}
function main(argv) {
  let input
  if (argv[0] === '--input') {
    input = absolutePath(argv[1], '--input')
    argv = argv.slice(2)
  }
  if (argv.length !== 1 || !['validate', 'setup'].includes(argv[0])) {
    throw new ConfigError('usage: agent-config [--input <absolute-path>] validate|setup')
  }
  input = input || path.join(configHome(), 'chezmoi', 'agent-config.json')
  const { config } = validateConfig(fs.readFileSync(input, 'utf8'))
  if (argv[0] === 'setup') {
    setupDirectories(config, { xdgConfigHome: configHome(), defaultEnvironment: config.defaults.environment })
  }
  return 0
}
try {
  process.exitCode = main(process.argv.slice(2))
} catch (error) {
  process.stderr.write(`agent-config: ${error instanceof Error ? error.message : 'failed'}\n`)
  process.exitCode = error && Number.isInteger(error.exitCode) ? error.exitCode : 2
}
