#!/usr/bin/env python3
"""Summarize recorded skill events without reading session transcripts."""

import argparse
import json
import os
import re
from collections import Counter, defaultdict
from datetime import date, datetime, timezone
from pathlib import Path


def utc_date(value):
    """Accept an ISO date or a timestamp with an explicit UTC offset."""
    if not isinstance(value, str):
        raise ValueError("expected date or timestamp")
    if len(value) == 10:
        return date.fromisoformat(value)
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    stamp = datetime.fromisoformat(value)
    if stamp.tzinfo is None:
        raise ValueError("missing time zone")
    return stamp.astimezone(timezone.utc).date()


def summarize(lines, since, until):
    rows = defaultdict(Counter)
    runs = defaultdict(set)
    ignored = Counter()
    events = {"started", "finished", "completed", "blocked", "decision", "feedback"}
    for line in lines:
        try:
            event = json.loads(line)
            if not isinstance(event, dict):
                raise ValueError
            day = utc_date(event.get("timestamp") or event.get("at"))
        except (ValueError, OverflowError):
            ignored["invalid_json_or_date"] += 1
            continue
        if (since and day < since) or (until and day >= until):
            continue
        skill = event.get("skill") or event.get("skillName")
        kind = event.get("event")
        if not isinstance(kind, str) or kind not in events:
            ignored["other_event"] += 1
            continue
        if not isinstance(skill, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,63}", skill):
            ignored["invalid_skill"] += 1
            continue
        rows[skill][kind] += 1
        if kind in {"started", "finished", "completed", "blocked"}:
            run = event.get("runId")
            if isinstance(run, str) and run.strip():
                runs[(skill, run)].add(kind)
            else:
                ignored["uncorrelated_lifecycle_event"] += 1

    for (skill, _), kinds in runs.items():
        start = "started" in kinds
        end = bool(kinds & {"finished", "completed", "blocked"})
        key = "paired_runs" if start and end else "start_only_runs" if start else "end_only_runs"
        rows[skill][key] += 1

    columns = ("started", "finished", "completed", "blocked", "decision", "feedback",
               "paired_runs", "start_only_runs", "end_only_runs")
    return {
        "since": since.isoformat() if since else None,
        "until": until.isoformat() if until else None,
        "skills": {skill: {k: row[k] for k in columns} for skill, row in sorted(rows.items())},
        "ignored": dict(ignored),
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    root = Path(os.environ.get("SKILL_AUDIT_ROOT") or Path.home() / ".local/state/agent-skills")
    parser.add_argument("--log", type=Path, default=root / "audit.jsonl")
    parser.add_argument("--since", type=date.fromisoformat, help="inclusive UTC date (YYYY-MM-DD)")
    parser.add_argument("--until", type=date.fromisoformat, help="exclusive UTC date (YYYY-MM-DD)")
    args = parser.parse_args()
    if args.since and args.until and args.since >= args.until:
        parser.error("--since must precede --until")
    try:
        with args.log.open(encoding="utf-8", errors="replace") as log:
            result = summarize(log, args.since, args.until)
    except OSError as error:
        parser.exit(1, f"agent-skill-audit: cannot read audit log (errno {error.errno})\n")
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
