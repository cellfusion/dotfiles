#!/usr/bin/env bash
# Launch Claude/Codex in a selected environment, or OMP in its native default state.
set -eu

usage_error() {
  printf 'agent: %s\n' "$1" >&2
  printf 'usage: agent --family=claude|codex|omp [--environment=<name>] -- [arguments...]\n' >&2
  exit 2
}
family=""
family_seen=0
environment=""
environment_seen=0
forward=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --) shift; forward+=("$@"); break ;;
    --family=*)
      [ "$family_seen" -eq 0 ] || usage_error '--family may only be specified once'
      family_seen=1; family="${1#--family=}" ;;
    --family)
      [ "$family_seen" -eq 0 ] || usage_error '--family may only be specified once'
      [ "$#" -ge 2 ] || usage_error '--family needs a value'
      family_seen=1; family="$2"; shift ;;
    --environment=*)
      [ "$environment_seen" -eq 0 ] || usage_error '--environment may only be specified once'
      environment_seen=1; environment="${1#--environment=}" ;;
    --environment)
      [ "$environment_seen" -eq 0 ] || usage_error '--environment may only be specified once'
      [ "$#" -ge 2 ] || usage_error '--environment needs a value'
      environment_seen=1; environment="$2"; shift ;;
    --provider|--provider=*) usage_error '--provider is not supported' ;;
    *) forward+=("$1") ;;
  esac
  shift
done
case "$family" in
  omp)
    [ "$environment_seen" -eq 0 ] || usage_error 'OMP uses default state; --environment is not supported'
    unset OMP_PROFILE PI_CODING_AGENT_DIR
    exec omp ${forward[@]+"${forward[@]}"} ;;
  claude|codex) ;;
  *) usage_error '--family must be claude, codex, or omp' ;;
esac
[ "$environment_seen" -eq 0 ] || [ -n "$environment" ] || usage_error '--environment needs a value'
self_dir="$(cd "$(dirname "$0")" && pwd)"
share=""
for candidate in "$self_dir/../share/agent-config" "$self_dir/../private_share/agent-config"; do
  if [ -f "$candidate/launch-env.js" ]; then
    share="$(cd "$candidate" && pwd)"
    break
  fi
done
if [ -z "$share" ]; then
  printf 'agent: launch-env.js not found\n' >&2
  exit 2
fi
launch_args=(--family "$family")
[ "$environment_seen" -eq 0 ] || launch_args+=(--environment "$environment")
if ! assignments="$(node "$share/launch-env.js" "${launch_args[@]}")"; then exit 2; fi
binary=""
while IFS=' ' read -r kind key value; do
  case "$kind" in
    binary) binary="$key" ;;
    env) export "$key=$value" ;;
    *) printf 'agent: invalid launch-env.js output\n' >&2; exit 2 ;;
  esac
done <<EOF
$assignments
EOF
[ -n "$binary" ] || usage_error 'no CLI selected'
exec "$binary" ${forward[@]+"${forward[@]}"}
