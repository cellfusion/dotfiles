#!/usr/bin/env node
'use strict'

const fs = require('node:fs')
const path = require('node:path')

const AGENT_CONFIG_DIR_CANDIDATES = [
  path.join(__dirname, '..', 'share', 'agent-config'),
  path.join(__dirname, '..', 'private_share', 'agent-config'),
]
const AGENT_CONFIG_DIR = AGENT_CONFIG_DIR_CANDIDATES.find((directory) =>
  fs.existsSync(path.join(directory, 'config-validator.js')))
  || AGENT_CONFIG_DIR_CANDIDATES[0]

const { validateConfig, ConfigError } = require(path.join(AGENT_CONFIG_DIR, 'config-validator.js'))
const { resolveDispatch, resolveExport } = require(path.join(AGENT_CONFIG_DIR, 'resolver.js'))
const {
  assertAvailabilitySnapshot,
  materializePaseo,
  resolvePaseoLaunch,
} = require(path.join(AGENT_CONFIG_DIR, 'paseo-exporter.js'))
const { mergeManagedPaseo } = require(path.join(AGENT_CONFIG_DIR, 'raw-json-merge.js'))

function isObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value)
}

function fail(message) {
  throw new ConfigError(message)
}

function requireAbsolutePath(value, option) {
  if (typeof value !== 'string' || !path.isAbsolute(value)) fail(`${option}: 絶対 path が必要である`)
  return value
}

function requireAbsoluteFile(value, option) {
  requireAbsolutePath(value, option)
  let stats
  try {
    stats = fs.statSync(value)
  } catch {
    fail(`${option}: file が存在しない`)
  }
  if (!stats.isFile()) fail(`${option}: regular file が必要である`)
  return value
}

function homeDirectory() {
  if (typeof process.env.HOME !== 'string' || process.env.HOME.length === 0 || !path.isAbsolute(process.env.HOME)) {
    fail('HOME: 絶対 path が必要である')
  }
  return process.env.HOME
}

function defaultInputPath(home) {
  const configHome = process.env.XDG_CONFIG_HOME || path.join(home === undefined ? homeDirectory() : home, '.config')
  requireAbsolutePath(configHome, 'XDG_CONFIG_HOME')
  return path.join(configHome, 'chezmoi', 'agent-config.json')
}

function defaultTargetPath(home) {
  return path.join(home, '.paseo', 'config.json')
}

function resolveWritePaths(args) {
  let home
  const getHome = () => {
    if (home === undefined) home = homeDirectory()
    return home
  }
  const input = args.input === undefined
    ? defaultInputPath(home)
    : requireAbsolutePath(args.input, '--input')
  const paseoConfig = args.paseoConfig === undefined
    ? defaultTargetPath(getHome())
    : requireAbsolutePath(args.paseoConfig, '--paseo-config')
  return { input, paseoConfig }
}

function isMissingFileError(error) {
  return error && (error.code === 'ENOENT' || error.code === 'ENOTDIR')
}

function existingRegularFile(pathname, label) {
  try {
    const stats = fs.statSync(pathname)
    if (!stats.isFile()) fail(`${label}: regular file が必要である`)
    return true
  } catch (error) {
    if (isMissingFileError(error)) return false
    if (error instanceof ConfigError) throw error
    fail(`${label}: file を検査できない`)
  }
}

function warnMissingFiles(inputPresent, targetPresent) {
  if (!inputPresent) process.stderr.write('generate-paseo-config: input agent-config.json が存在しないため skip する\n')
  if (!targetPresent) process.stderr.write('generate-paseo-config: target config.json が存在しないため skip する\n')
}

function parseArgs(argv) {
  const globals = { input: undefined, paseoConfig: undefined }
  let index = 0
  while (index < argv.length) {
    const option = argv[index]
    if (option === '--input' || option === '--paseo-config') {
      if (index + 1 >= argv.length || argv[index + 1].startsWith('--')) fail(`${option}: value がない`)
      const key = option === '--input' ? 'input' : 'paseoConfig'
      if (globals[key] !== undefined) fail(`${option}: 重複している`)
      globals[key] = argv[index + 1]
      index += 2
      continue
    }
    break
  }

  let subcommand
  if (index < argv.length && argv[index] === 'resolve') {
    subcommand = 'resolve'
    index += 1
  }

  if (subcommand === undefined) {
    let check = false
    let diff = false
    while (index < argv.length) {
      if (argv[index] === '--check' && !check) {
        check = true
        index += 1
        continue
      }
      if (argv[index] === '--diff' && !diff) {
        diff = true
        index += 1
        continue
      }
      if (argv[index] === '--input' || argv[index] === '--paseo-config') {
        fail(`${argv[index]}: global option は subcommand より前に置く`)
      }
      fail(`option ${argv[index]}: 不明である`)
    }
    if (check && diff) fail('--check と --diff は同時に指定できない')
    return { ...globals, check, diff, subcommand: undefined, options: {} }
  }

  const options = {}
  while (index < argv.length) {
    const option = argv[index]
    if (option === '--input' || option === '--paseo-config' || option === '--check') {
      fail(`${option}: global option は subcommand より前に置く`)
    }
    const allowed = ['--project', '--role', '--provenance', '--snapshot', '--tier', '--environment']
    if (!allowed.includes(option)) fail(`option ${option}: 不明である`)
    const key = option.slice(2)
    if (options[key] !== undefined) fail(`${option}: 重複している`)
    if (index + 1 >= argv.length || argv[index + 1].startsWith('--')) fail(`${option}: value がない`)
    options[key] = argv[index + 1]
    index += 2
  }
  return { ...globals, check: false, subcommand, options }
}

function readFile(pathname, option) {
  requireAbsoluteFile(pathname, option)
  try {
    return fs.readFileSync(pathname, 'utf8')
  } catch {
    fail(`${option}: 読み込めない`)
  }
}

function writeAtomic(pathname, raw) {
  const directory = path.dirname(pathname)
  const basename = path.basename(pathname)
  let temporary
  let descriptor
  try {
    for (let attempt = 0; attempt < 20; attempt += 1) {
      const candidate = path.join(directory, `.${basename}.tmp-${process.pid}-${Date.now()}-${attempt}`)
      try {
        descriptor = fs.openSync(candidate, 'wx', 0o600)
        temporary = candidate
        break
      } catch (error) {
        if (error && error.code !== 'EEXIST') throw error
      }
    }
    if (!temporary || descriptor === undefined) fail('target: temporary file を作れない')
    fs.writeFileSync(descriptor, raw, 'utf8')
    fs.fsyncSync(descriptor)
    fs.closeSync(descriptor)
    descriptor = undefined
    fs.renameSync(temporary, pathname)
    temporary = undefined
    fs.chmodSync(pathname, 0o600)
    try {
      const directoryDescriptor = fs.openSync(directory, 'r')
      try { fs.fsyncSync(directoryDescriptor) } finally { fs.closeSync(directoryDescriptor) }
    } catch {
      // Directory fsync is not available on every supported filesystem.
    }
  } catch (error) {
    if (descriptor !== undefined) {
      try { fs.closeSync(descriptor) } catch {}
    }
    if (temporary !== undefined) {
      try { fs.unlinkSync(temporary) } catch {}
    }
    if (error instanceof ConfigError) throw error
    throw new ConfigError(`target: atomic write に失敗した (${error.code || 'I/O'})`)
  }
}

const MANAGED_PROFILE_FIELDS = ['id', 'name', 'provider', 'model', 'modeId', 'thinkingOptionId', 'featureValues']

function hasOwn(value, key) {
  return value !== null && typeof value === 'object' && Object.prototype.hasOwnProperty.call(value, key)
}

function existingManagedProfile(profile, materializedProfile) {
  if (!profile || typeof profile !== 'object' || Array.isArray(profile)) return null
  const projected = {}
  for (const key of MANAGED_PROFILE_FIELDS) {
    if (hasOwn(profile, key)) projected[key] = profile[key]
  }
  return projected
}

function existingManagedProvider(provider, materializedProvider) {
  if (!provider || typeof provider !== 'object' || Array.isArray(provider)) return null
  const projected = {}
  for (const key of ['extends', 'label']) {
    if (hasOwn(provider, key)) projected[key] = provider[key]
  }
  if (isObject(provider.env)) {
    const env = {}
    for (const key of Object.keys(materializedProvider.env)) {
      if (hasOwn(provider.env, key)) env[key] = provider.env[key]
    }
    if (Object.keys(env).length > 0) projected.env = env
  }
  return projected
}

function existingManagedProjection(raw, materialized) {
  let target
  try {
    target = JSON.parse(raw)
  } catch {
    fail('target: JSON として parse できない')
  }
  const profiles = isObject(target) && isObject(target.daemon) && Array.isArray(target.daemon.agentProfiles)
    ? target.daemon.agentProfiles
    : []
  const providers = isObject(target) && isObject(target.agents) && isObject(target.agents.providers)
    ? target.agents.providers
    : {}
  return {
    daemon: {
      agentProfiles: materialized.profiles.map((profile) => existingManagedProfile(
        profiles.find((entry) => isObject(entry) && entry.id === profile.id),
        profile,
      )),
    },
    agents: {
      providers: Object.fromEntries(Object.entries(materialized.providers).map(([id, provider]) => [
        id,
        existingManagedProvider(providers[id], provider),
      ])),
    },
  }
}

function formatManagedDiff(targetRaw, materialized, mergedRaw) {
  const before = JSON.stringify(existingManagedProjection(targetRaw, materialized), null, 2)
  const after = JSON.stringify(existingManagedProjection(mergedRaw, materialized), null, 2)
  if (before === after) return ''
  const oldLines = before.split('\n').map((line) => `-${line}`)
  const newLines = after.split('\n').map((line) => `+${line}`)
  return [
    '--- paseo managed/current',
    '+++ paseo managed/generated',
    '@@',
    ...oldLines,
    ...newLines,
  ].join('\n') + '\n'
}

function runWrite(args) {
  const paths = resolveWritePaths(args)
  const inputPresent = existingRegularFile(paths.input, '--input')
  const targetPresent = existingRegularFile(paths.paseoConfig, '--paseo-config')
  if (!inputPresent || !targetPresent) {
    warnMissingFiles(inputPresent, targetPresent)
    return 0
  }
  const inputPath = paths.input
  const targetPath = paths.paseoConfig
  const inputRaw = fs.readFileSync(inputPath, 'utf8')
  const { config } = validateConfig(inputRaw)
  const materialized = materializePaseo(resolveExport(config))
  const targetRaw = fs.readFileSync(targetPath, 'utf8')
  const merged = mergeManagedPaseo(targetRaw, materialized)
  for (const warning of merged.warnings) process.stderr.write(`${warning}\n`)
  if (args.check) return merged.changed ? 1 : 0
  if (args.diff) {
    if (merged.changed) process.stdout.write(formatManagedDiff(targetRaw, materialized, merged.raw))
    return merged.changed ? 1 : 0
  }
  writeAtomic(targetPath, merged.raw)
  return 0
}

// 親の AI 環境名を読む唯一の場所である。AGENT_ENV_SESSION は zsh が解決した名前で、
// AGENT_ENV は Paseo の provider record が入れる解決前の名前である。
function readParentEnvironment() {
  const session = process.env.AGENT_ENV_SESSION
  if (typeof session === 'string' && session.length > 0) return session
  const injected = process.env.AGENT_ENV
  if (typeof injected === 'string' && injected.length > 0) return injected
  return undefined
}

function runResolve(args) {
  if (args.input === undefined) fail('--input が必要である')
  const required = ['project', 'role', 'provenance', 'snapshot']
  for (const key of required) if (args.options[key] === undefined) fail(`--${key} が必要である`)
  const inputRaw = readFile(args.input, '--input')
  const { config } = validateConfig(inputRaw)
  const dispatch = resolveDispatch(config, {
    project: args.options.project,
    role: args.options.role,
    provenance: args.options.provenance,
    tier: args.options.tier,
    environment: args.options.environment,
    parentEnvironment: readParentEnvironment(),
  })
  const snapshotRaw = readFile(args.options.snapshot, '--snapshot')
  let snapshot
  try {
    snapshot = JSON.parse(snapshotRaw)
  } catch {
    fail('snapshot: JSON として parse できない')
  }
  assertAvailabilitySnapshot(snapshot)
  const launch = resolvePaseoLaunch(dispatch, snapshot)
  process.stdout.write(`${JSON.stringify(launch)}\n`)
  return launch.status === 'ok' ? 0 : 4
}

function main(argv) {
  const args = parseArgs(argv)
  if (args.subcommand === 'resolve') return runResolve(args)
  return runWrite(args)
}

try {
  process.exitCode = main(process.argv.slice(2))
} catch (error) {
  process.stderr.write(`generate-paseo-config: ${error instanceof Error ? error.message : '失敗した'}\n`)
  process.exitCode = error && Number.isInteger(error.exitCode) ? error.exitCode : 2
}
