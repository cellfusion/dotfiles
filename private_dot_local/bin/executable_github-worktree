#!/usr/bin/env python3
"""Open a selected GitHub PR, issue, or local/remote branch in a Herdr worktree."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
from urllib.parse import urlsplit


def run(*args, capture=False):
    return subprocess.run(args, check=True, text=True,
                          stdout=subprocess.PIPE if capture else None).stdout

def check_approvals():
    state = json.loads(run('wt', 'config', 'approvals', 'list', '--format=json', capture=True))
    if not isinstance(state, dict) or state.get('state') not in ('no_commands', 'approved', 'approval_required'):
        raise RuntimeError('Unable to determine Worktrunk project approval state')
    if state['state'] == 'approval_required' and sys.stdin.isatty():
        if not isinstance(state.get('commands'), list) or not isinstance(state.get('stale'), list):
            raise RuntimeError('Invalid Worktrunk project approval response')
        run('wt', 'config', 'approvals', 'add')
        state = json.loads(run('wt', 'config', 'approvals', 'list', '--format=json', capture=True))
    if not isinstance(state, dict) or state.get('state') not in ('no_commands', 'approved'):
        raise RuntimeError('Project commands need approval; inspect them with '
                           'wt config approvals list and approve with wt config approvals add')
    if not isinstance(state.get('commands'), list) or not isinstance(state.get('stale'), list):
        raise RuntimeError('Invalid Worktrunk project approval response')
    if any(not isinstance(command, dict) or command.get('approved') is not True
           for command in state['commands']):
        raise RuntimeError('Invalid or unapproved Worktrunk project commands')
    if state['state'] == 'no_commands' and state['commands']:
        raise RuntimeError('Inconsistent Worktrunk project approval response')



def checkout_identity(path):
    result = subprocess.run(
        ['git', '-C', str(path), 'rev-parse', '--path-format=absolute',
         '--show-toplevel', '--git-common-dir'],
        text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if result.returncode:
        return None
    root, common = result.stdout.splitlines()
    return Path(root).resolve(), Path(common).resolve()


def open_checkouts(include_panes=False):
    herdr = os.environ.get('HERDR_BIN_PATH', 'herdr')
    workspaces = json.loads(run(herdr, 'workspace', 'list', capture=True))['result']['workspaces']
    panes = json.loads(run(herdr, 'pane', 'list', capture=True))['result']['panes']
    candidates = []
    seen = set()
    for workspace in workspaces:
        metadata = workspace.get('worktree') or {}
        paths = [metadata['checkout_path']] if metadata.get('checkout_path') else []
        if include_panes or not paths:
            paths.extend(path for pane in panes
                         if pane['workspace_id'] == workspace['workspace_id']
                         for path in (pane.get('cwd'), pane.get('foreground_cwd')))
        for path in filter(None, paths):
            identity = checkout_identity(path)
            if identity and (workspace['workspace_id'], identity[0]) not in seen:
                seen.add((workspace['workspace_id'], identity[0]))
                candidates.append((workspace['workspace_id'], *identity))
    # Prefer the main checkout as the parent, not another linked worktree.
    return sorted(candidates, key=lambda item: item[1] / '.git' != item[2])


def repository_identity(url):
    if '://' not in url and ':' in url:
        host, path = url.split(':', 1)
        url = 'ssh://' + host + '/' + path
    parsed = urlsplit(url)
    path = parsed.path.strip('/').removesuffix('.git')
    return (parsed.hostname or '').lower(), path.lower()


def matches_repository(path, url):
    result = subprocess.run(
        ['git', '-C', str(path), 'config', '--get-regexp', r'^remote\..*\.url$'],
        text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if result.returncode not in (0, 1):
        raise RuntimeError(f'Unable to inspect repository remotes: {path}')
    target = repository_identity(url)
    return any(repository_identity(line.split(None, 1)[1]) == target
               for line in result.stdout.splitlines())


def target_checkout(repo):
    current = checkout_identity(Path.cwd())
    candidates = [candidate for candidate in open_checkouts()
                  if matches_repository(candidate[1], repo['url'])]
    if current:
        local = [candidate for candidate in candidates if candidate[2] == current[1]]
        if local:
            return local[0][1]
    if candidates:
        return candidates[0][1]
    if current and matches_repository(current[0], repo['url']):
        return current[0]
    raise RuntimeError(f"No open or current checkout found for {repo['nameWithOwner']}; open it in Herdr first")


def open_workspace(label):
    path, common = checkout_identity(Path.cwd())
    candidates = [candidate for candidate in open_checkouts() if candidate[2] == common]
    # Let Herdr register the repository relationship even for an already open checkout.
    source = ['--workspace', candidates[0][0]] if candidates else ['--cwd', str(path)]
    run(os.environ.get('HERDR_BIN_PATH', 'herdr'), 'worktree', 'open', *source, '--path', str(path),
        '--label', label, '--focus')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('kind', choices=['pr', 'issue', 'branch', 'new', 'remove'])
    parser.add_argument('selection', nargs='?', help='PR/issue number, branch name, or worktree path')
    parser.add_argument('--repo', help='GitHub repository: [HOST/]OWNER/REPO')
    parser.add_argument('--remote', help='remote for the selected branch (branch mode only)')
    parser.add_argument('--review', action='store_true', help='start an isolated PR review instead')
    parser.add_argument('--open-workspace', metavar='LABEL', help=argparse.SUPPRESS)
    args = parser.parse_args()
    inside_herdr = os.environ.get('HERDR_ENV') == '1'
    if not inside_herdr and (args.kind not in ('branch', 'new') or args.open_workspace):
        parser.error('PR, issue, review, and safe removal require Herdr')
    if args.open_workspace:
        open_workspace(args.open_workspace)
        return
    if not args.selection:
        parser.error('a selection is required')
    if args.review and args.kind != 'pr':
        parser.error('--review requires pr')
    if args.remote is not None and args.kind != 'branch':
        parser.error('--remote requires branch')
    if args.kind == 'remove':
        path = Path(args.selection).resolve()
        target_identity = checkout_identity(path)
        current_identity = checkout_identity(Path.cwd())
        if not target_identity or target_identity[0] != path:
            raise RuntimeError('Select an existing worktree root to remove')
        if not current_identity or current_identity[1] != target_identity[1]:
            raise RuntimeError('Selected worktree does not belong to the current repository')
        if any(candidate[1] == path for candidate in open_checkouts(include_panes=True)):
            raise RuntimeError(f'Worktree is open in Herdr; close its workspace first: {path}')
        check_approvals()
        run('wt', 'remove', '--foreground', '--no-delete-branch', str(path))
        return
    branch_options = []
    selected = args.selection
    if args.kind in ('branch', 'new'):
        if args.repo:
            parser.error('--repo is not supported for local branches')
        identity = checkout_identity(Path.cwd())
        if not identity:
            raise RuntimeError('Run from a local Git checkout')
        os.chdir(identity[0])
        local_ref = f'refs/heads/{selected}'
        exists = subprocess.run(['git', 'show-ref', '--verify', '--quiet', local_ref])
        if exists.returncode not in (0, 1):
            raise RuntimeError(f'Unable to inspect local branch: {selected}')
        if args.kind == 'new':
            if subprocess.run(['git', 'check-ref-format', '--branch', selected],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
                raise RuntimeError(f'Invalid branch name: {selected}')
            if exists.returncode == 1:
                branch_options = ['--create', '--base', '@']
        elif args.remote is not None:
            remote_ref = f'refs/remotes/{args.remote}/{selected}'
            remote_exists = subprocess.run(['git', 'show-ref', '--verify', '--quiet', remote_ref])
            if remote_exists.returncode or selected == 'HEAD':
                raise RuntimeError(f'Unable to find remote branch: {args.remote}/{selected}')
            if exists.returncode == 0:
                upstream = subprocess.run(
                    ['git', 'for-each-ref', '--format=%(upstream)', local_ref],
                    check=True, text=True, stdout=subprocess.PIPE).stdout.strip()
                if upstream != remote_ref:
                    raise RuntimeError(
                        f'Local branch {selected} does not track {args.remote}/{selected}; '
                        'rename it or choose the local branch explicitly')
            else:
                branch_options = ['--create', '--base', remote_ref]
        elif exists.returncode:
            raise RuntimeError(f'Unable to find local branch: {selected}')
        label = selected
        target = selected
    else:
        if not selected.isascii() or not selected.isdecimal() or int(selected) < 1:
            parser.error('PR/issue number must be a positive integer')
        view = ['gh', 'repo', 'view']
        if args.repo:
            view.append(args.repo)
        repo = json.loads(run(*view, '--json', 'nameWithOwner,defaultBranchRef,url', capture=True))
        repository = f"{urlsplit(repo['url']).netloc}/{repo['nameWithOwner']}"
        # Resolve the actual item before changing any checkout state.
        url = run('gh', args.kind, 'view', selected, '--repo', repository,
                  '--json', 'url', '--jq', '.url', capture=True).strip()
        os.chdir(target_checkout(repo))
        check_approvals()
        if args.review:
            run('pr-review', '--environment', 'herdr', '--repo-path', str(Path.cwd()), url)
            return
        label = f'{repository.split("/")[-1]} {args.kind} #{selected}'
        target = url if args.kind == 'pr' else f'issue/{selected}'
    if args.kind in ('branch', 'new'):
        check_approvals()
    switch = ['wt', 'switch', '--no-cd', *branch_options]
    if args.kind == 'issue':
        exists = subprocess.run(['git', 'show-ref', '--verify', '--quiet', f'refs/heads/{target}'])
        if exists.returncode == 1:
            base = repo['defaultBranchRef']['name']
            run('git', 'fetch', repo['url'], f'refs/heads/{base}')
            switch += ['--create', '--base', 'FETCH_HEAD']
        elif exists.returncode:
            raise RuntimeError('Unable to inspect local issue branch')
    if inside_herdr:
        # Worktrunk executes this in the selected checkout, including on reuse.
        run(*switch, target, '--execute', sys.executable, '--', str(Path(__file__).resolve()),
            args.kind, '--open-workspace', label)
    else:
        run(*switch, target)


if __name__ == '__main__':
    try:
        main()
    except (subprocess.CalledProcessError, OSError, ValueError, KeyError, RuntimeError) as error:
        print(f'github-worktree: {error}', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
