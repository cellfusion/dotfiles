{
  "type": "object",
  "required": ["summary", "points", "conflicts", "decisionRequest"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "points": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": ["array", "null"], "items": { "type": "string" } },
    "decisionRequest": {{ includeTemplate "agent-defs/schemas/_decision-request.json" . }}
  }
}
