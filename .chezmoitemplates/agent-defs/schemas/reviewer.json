{
  "type": "object",
  "required": ["status", "findings", "strengths", "decisionRequest"],
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "summary", "location", "fix"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "important", "minor"] },
          "summary": { "type": "string" },
          "location": { "type": "string" },
          "fix": { "type": ["string", "null"] }
        }
      }
    },
    "strengths": { "type": ["string", "null"] },
    "decisionRequest": {{ includeTemplate "agent-defs/schemas/_decision-request.json" . }}
  }
}
