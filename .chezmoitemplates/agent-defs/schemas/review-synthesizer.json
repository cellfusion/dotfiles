{
  "type": "object",
  "required": ["verdict", "findings", "summary", "strengths", "decisionRequest"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["approved", "needs_fixes"] },
    "findings": {
      "type": "array",
      "items": {{ includeTemplate "agent-defs/schemas/_finding-item.json" . }}
    },
    "summary": { "type": "string" },
    "strengths": { "type": ["string", "null"] },
    "decisionRequest": {{ includeTemplate "agent-defs/schemas/_decision-request.json" . }}
  }
}
