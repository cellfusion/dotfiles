{{- $claude := dict
      "family" "claude"
      "models" (dict "fast" "claude-sonnet-5" "work" "claude-sonnet-5" "think" "claude-opus-5" "deep" "claude-opus-5")
      "thinking" (dict "fast" "medium" "work" "high" "think" "high" "deep" "max")
      "modes" (dict "read" "plan" "write" "bypassPermissions") -}}
{{- $codex := dict
      "family" "codex"
      "models" (dict "fast" "gpt-5.6-luna" "work" "gpt-5.6-luna" "think" "gpt-5.6-terra" "deep" "gpt-5.6-sol")
      "thinking" (dict "fast" "medium" "work" "high" "think" "high" "deep" "high")
      "modes" (dict "read" "auto" "write" "auto") -}}
{{- /*
  provider の一覧は [[data.environments]] から作る。id の規則は Paseo の provider を作る
  .chezmoiscripts/run_onchange_after_90-agent-envs.sh.tmpl と同じで、先頭環境は接尾辞を
  持たず、2 つ目以降が `<agent>-<session>` になる。両者がずれると、Paseo に存在しない
  provider を MAD が候補に選ぶ。
*/ -}}
{{- $base := dict "claude" $claude "codex" $codex -}}
{{- $envs := list (dict "session" "default" "label" "P1" "agents" (list "claude" "codex")) -}}
{{- if hasKey . "environments" }}{{ $envs = .environments }}{{ end -}}
{{- $out := dict -}}
{{- range $i, $env := $envs -}}
{{-   $label := "" -}}
{{-   if hasKey $env "label" -}}{{- $label = $env.label -}}{{- end -}}
{{-   range $agent := $env.agents -}}
{{-     if hasKey $base $agent -}}
{{-       $id := $agent -}}
{{-       if $i -}}{{- $id = printf "%s-%s" $agent $env.session -}}{{- end -}}
{{-       $entry := merge (dict "usage" (dict "environment" $label "agent" $agent)) (index $base $agent) -}}
{{-       $out = set $out $id $entry -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ $out | toPrettyJson }}
