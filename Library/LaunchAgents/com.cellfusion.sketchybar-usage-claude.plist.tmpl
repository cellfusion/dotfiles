<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cellfusion.sketchybar-usage-claude</string>
    <!-- Legacy Claude cache collector. Disabled; the shared agent-usage job replaces it.
         Background: ~/.config/docs/sketchybar-usage.md -->
    <key>ProgramArguments</key>
    <array>
        <string>{{ .chezmoi.homeDir }}/.config/sketchybar/helpers/usage_collect_claude.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>Disabled</key>
    <true/>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/sketchybar-usage-claude.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/sketchybar-usage-claude.err.log</string>
</dict>
</plist>
