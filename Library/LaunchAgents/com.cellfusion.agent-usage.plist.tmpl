<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.cellfusion.agent-usage</string>
<key>ProgramArguments</key><array><string>{{ .chezmoi.homeDir }}/.local/lib/agent-usage/collect.sh</string></array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>60</integer>
<key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/agent-usage.log</string>
<key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/agent-usage.err.log</string>
</dict></plist>
